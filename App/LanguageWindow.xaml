<Window x:Class="ClickClean.LanguageWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Click-Clean · Language" Width="390" Height="300" MinWidth="340" MinHeight="270" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Surface}" Foreground="{DynamicResource Text}" FontFamily="Segoe UI, Microsoft YaHei UI" UseLayoutRounding="True"
        Icon="pack://application:,,,/ClickClean;component/Assets/ClickClean.png">
  <Border><Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="选择语言 / Choose language" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="可随时在设置中更改 / Change it in Settings" Style="{StaticResource Caption}" Margin="0,8,0,20"/></StackPanel>
    <ComboBox x:Name="Languages" Grid.Row="1" SelectedIndex="0" AutomationProperties.Name="语言 / Language" MinHeight="42"><ComboBoxItem Content="简体中文"/><ComboBoxItem Content="English"/></ComboBox>
    <Button Grid.Row="3" Content="继续 / Continue" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Continue_Click" Height="42" HorizontalAlignment="Stretch"/>
  </Grid></Border>
</Window>
