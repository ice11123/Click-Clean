<UserControl x:Class="ClickClean.IslandView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Height="108" MinWidth="240">
  <Grid>
    <Border x:Name="Pill" Background="{DynamicResource IslandBg}" BorderBrush="{DynamicResource IslandText}" CornerRadius="48" Height="100" RenderTransformOrigin="0.5,0.5">
      <Border.RenderTransform><ScaleTransform x:Name="PillScale" ScaleX="0.82" ScaleY="0.64"/></Border.RenderTransform>
    </Border>
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <Ellipse x:Name="Dot" Width="7" Height="7" Fill="#83ADF9" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <TextBlock x:Name="TitleText" Text="即清 · 随时就绪" Foreground="{DynamicResource IslandText}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" MaxWidth="280"/>
      </StackPanel>
      <TextBlock x:Name="DetailText" Text="" Visibility="Collapsed" Foreground="{DynamicResource IslandMuted}" FontSize="11" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" MaxWidth="285" HorizontalAlignment="Center"/>
    </StackPanel>
  </Grid>
</UserControl>
