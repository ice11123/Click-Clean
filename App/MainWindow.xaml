<Window x:Class="ClickClean.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:ClickClean" xmlns:views="clr-namespace:ClickClean.Views"
        Title="{loc:Tr Click-Clean 即清}" Width="720" Height="560" MinWidth="440" MinHeight="540" WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/ClickClean;component/Assets/ClickClean.png" Background="{DynamicResource Surface}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI, Microsoft YaHei UI" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Grid x:Name="LayoutRoot">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Grid.RowSpan="2" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
      <Border.Style><Style TargetType="Border"><Setter Property="Width" Value="132"/><Style.Triggers><DataTrigger Binding="{Binding Compact}" Value="True"><Setter Property="Width" Value="64"/></DataTrigger></Style.Triggers></Style></Border.Style>
      <Grid Margin="0,24,0,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="20,0,0,30"><Image Source="pack://application:,,,/ClickClean;component/Assets/ClickClean.png" Width="24" Height="24" AutomationProperties.Name="{loc:Tr Click-Clean 原图标}"/><TextBlock Text="{loc:Tr 即清}" FontSize="20" FontWeight="SemiBold" Style="{StaticResource SidebarLabel}"/></StackPanel>
        <StackPanel Grid.Row="1"><Button x:Name="OverviewButton" Command="{Binding Command}" CommandParameter="overview" ToolTip="{loc:Tr 首页}" AutomationProperties.Name="{loc:Tr 首页}" Margin="8,3">
          <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SidebarButton}"><Style.Triggers><DataTrigger Binding="{Binding Overview}" Value="True"><Setter Property="Background" Value="{DynamicResource Tint}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter Property="BorderThickness" Value="2,0,0,0"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></Button.Style>
          <StackPanel Orientation="Horizontal"><Path Data="M 2,9 L 10,2 18,9 M 4,8 L 4,18 8,18 8,12 12,12 12,18 16,18 16,8" Width="18" Height="18" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/><TextBlock Text="{loc:Tr 首页}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Style="{StaticResource SidebarLabel}"/></StackPanel>
        </Button>
<Button x:Name="HistoryButton" Command="{Binding Command}" CommandParameter="history" ToolTip="{loc:Tr 记录}" AutomationProperties.Name="{loc:Tr 记录}" Margin="8,3">
          <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SidebarButton}"><Style.Triggers><DataTrigger Binding="{Binding Records}" Value="True"><Setter Property="Background" Value="{DynamicResource Tint}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter Property="BorderThickness" Value="2,0,0,0"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></Button.Style>
          <StackPanel Orientation="Horizontal"><Path Data="M 4,3 L 16,3 16,18 4,18 Z M 7,7 L 13,7 M 7,11 L 13,11 M 7,15 L 11,15" Width="18" Height="18" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/><TextBlock Text="{loc:Tr 记录}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Style="{StaticResource SidebarLabel}"/></StackPanel>
        </Button>
<Button x:Name="DiagnosticsButton" Command="{Binding Command}" CommandParameter="diagnostics" ToolTip="{loc:Tr 进程}" AutomationProperties.Name="{loc:Tr 进程}" Margin="8,3">
          <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SidebarButton}"><Style.Triggers><DataTrigger Binding="{Binding Diagnostics}" Value="True"><Setter Property="Background" Value="{DynamicResource Tint}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter Property="BorderThickness" Value="2,0,0,0"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></Button.Style>
          <StackPanel Orientation="Horizontal"><Path Data="M 2,16 L 2,9 6,9 6,16 Z M 8,16 L 8,3 12,3 12,16 Z M 14,16 L 14,6 18,6 18,16 Z" Width="18" Height="18" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/><TextBlock Text="{loc:Tr 进程}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Style="{StaticResource SidebarLabel}"/></StackPanel>
        </Button></StackPanel>
        <StackPanel Grid.Row="3"><Button x:Name="SettingsButton" Command="{Binding Command}" CommandParameter="settings" ToolTip="{loc:Tr 设置}" AutomationProperties.Name="{loc:Tr 设置}" Margin="8,3">
          <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SidebarButton}"><Style.Triggers><DataTrigger Binding="{Binding SettingsPage}" Value="True"><Setter Property="Background" Value="{DynamicResource Tint}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter Property="BorderThickness" Value="2,0,0,0"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></Button.Style>
          <StackPanel Orientation="Horizontal"><Path Data="M 3,5 L 17,5 M 3,10 L 17,10 M 3,15 L 17,15 M 7,2 L 7,8 M 13,7 L 13,13 M 8,12 L 8,18" Width="18" Height="18" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/><TextBlock Text="{loc:Tr 设置}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Style="{StaticResource SidebarLabel}"/></StackPanel>
        </Button><TextBlock Text="{Binding Version}" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,10,0,0"/></StackPanel>
      </Grid>
    </Border>
    <Grid x:Name="ContentFrame" Grid.Column="1" Margin="28,24,28,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
      <Border x:Name="HomeUpdateBanner" Visibility="{Binding HomeBannerVisible, Converter={StaticResource Visible}}" Background="{DynamicResource Tint}" BorderBrush="{DynamicResource DetailAccent}" BorderThickness="3,0,0,0" Padding="10,7" Margin="0,0,0,16" AutomationProperties.LiveSetting="Polite">
        <Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="HomeUpdateText" Text="{Binding UpdateText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding UpdateText}" VerticalAlignment="Center" FontSize="12" Margin="0,0,8,0"/>
          <Button x:Name="HomeUpdateButton" Grid.Column="1" Content="{Binding UpdateButton}" IsEnabled="{Binding UpdateActionEnabled}" Style="{StaticResource TextButton}" Command="{Binding Command}" CommandParameter="home-update"/>
          <Button x:Name="HomeCancelUpdate" Grid.Column="2" Content="{loc:Tr 取消}" Style="{StaticResource TextButton}" Visibility="{Binding UpdateBusy, Converter={StaticResource Visible}}" Command="{Binding Command}" CommandParameter="cancel-update"/>
          <ProgressBar x:Name="HomeUpdateProgress" Grid.Row="1" Grid.ColumnSpan="3" Value="{Binding DownloadProgress}" IsIndeterminate="{Binding DownloadIndeterminate}" Visibility="{Binding Downloading, Converter={StaticResource Visible}}" Maximum="100" Height="3" Margin="0,5,0,0" Foreground="{DynamicResource Accent}" AutomationProperties.Name="{loc:Tr 实际更新下载进度}"/>
        </Grid>
      </Border>
      <Border Grid.Row="1" x:Name="RecoveryBanner" Visibility="{Binding RecoveryVisible, Converter={StaticResource Visible}}" Background="{DynamicResource Tint}" Padding="12" Margin="0,0,0,16"><StackPanel><TextBlock Text="{loc:Tr 上次更新未完成启动，可重试或从发行历史恢复安装。}" Style="{StaticResource Caption}"/><Button Content="{loc:Tr 打开发行历史}" Style="{StaticResource TextButton}" Command="{Binding Command}" CommandParameter="releases" HorizontalAlignment="Left"/></StackPanel></Border>
      <Grid Grid.Row="2">
        <views:OverviewView x:Name="OverviewPane" Visibility="{Binding Overview, Converter={StaticResource Visible}}"/>
        <views:HistoryView x:Name="HistoryPane" Visibility="{Binding Records, Converter={StaticResource Visible}}"/>
        <views:DiagnosticsView x:Name="DiagnosticsPane" Visibility="{Binding Diagnostics, Converter={StaticResource Visible}}"/>
        <views:SettingsView x:Name="SettingsPane" Visibility="{Binding SettingsPage, Converter={StaticResource Visible}}"/>
      </Grid>
    </Grid>
    <Grid x:Name="Footer" Grid.Column="1" Grid.Row="1" Margin="28,12,28,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="{loc:Tr 原作者：离子怪}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="RepositoryLinkButton" Style="{StaticResource ProjectLink}" Width="32" Height="32" Command="{Binding Command}" CommandParameter="repository" Margin="4,0,0,0" ToolTip="https://github.com/ice11123/Click-Clean" AutomationProperties.Name="{loc:Tr 打开 Click-Clean GitHub 开源仓库}"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource LinkGlyph}" Margin="0" Data="M 4,2 A 2,2 0 1 0 4,6 A 2,2 0 1 0 4,2 M 4,6 L 4,13 M 4,13 A 2,2 0 1 0 4,17 A 2,2 0 1 0 4,13 M 4,10 C 12,10 12,9 12,6 M 12,2 A 2,2 0 1 0 12,6 A 2,2 0 1 0 12,2"/></StackPanel></Button>
<Button x:Name="BlogLinkButton" Style="{StaticResource ProjectLink}" Width="32" Height="32" Command="{Binding Command}" CommandParameter="blog" Margin="4,0,0,0" ToolTip="https://ice11123.github.io/blog_test2/" AutomationProperties.Name="{loc:Tr 打开离子怪博客}"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource LinkGlyph}" Margin="0" Data="M 2,3 Q 6,1 10,4 Q 14,1 18,3 L 18,16 Q 14,14 10,17 Q 6,14 2,16 Z M 10,4 L 10,17"/></StackPanel></Button>
<Button x:Name="AuthorLinkButton" Style="{StaticResource ProjectLink}" Width="32" Height="32" Command="{Binding Command}" CommandParameter="author" ToolTip="https://github.com/ice11123" AutomationProperties.Name="{loc:Tr 打开离子怪 GitHub 首页}"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource LinkGlyph}" Margin="0" Data="M 10,2 A 3.5,3.5 0 1 0 10,9 A 3.5,3.5 0 1 0 10,2 M 3,18 L 3,16 Q 3,11 10,11 Q 17,11 17,16 L 17,18 Z"/></StackPanel></Button></StackPanel>
    </Grid>
    <Popup x:Name="DetailsPopup" Placement="Bottom" AllowsTransparency="True" StaysOpen="False" DataContext="{Binding}">
      <Border x:Name="PopupFrame" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="16" Width="460" KeyboardNavigation.TabNavigation="Cycle">
        <Border.RenderTransform><TranslateTransform x:Name="PopupShift"/></Border.RenderTransform>
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><Button Content="{loc:Tr 关闭 ×}" Style="{StaticResource TextButton}" HorizontalAlignment="Right" Command="{Binding Command}" CommandParameter="close-popup" AutomationProperties.Name="{loc:Tr 关闭详情}"/>
          <ScrollViewer x:Name="PopupScroll" Grid.Row="1" MaxHeight="380"><StackPanel>
            <views:ResultDetailsView Visibility="{Binding ResultPopup, Converter={StaticResource Visible}}"/>
            <StackPanel Visibility="{Binding MemoryPopup, Converter={StaticResource Visible}}"><TextBlock Text="{loc:Tr 内存详情}" Style="{StaticResource PageTitle}"/><TextBlock Text="{loc:Tr 已用 / 总量}" Style="{StaticResource Caption}"/><TextBlock Margin="0,6,0,16"><Run Text="{Binding Used}"/><Run Text=" / "/><Run Text="{Binding Total}"/></TextBlock><TextBlock Text="{loc:Tr 提交量 / 上限}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Commit}" Margin="0,6,0,16" Typography.NumeralAlignment="Tabular"/><TextBlock Text="{loc:Tr 系统缓存（含系统工作集）}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Cache}" Margin="0,6,0,8"/><TextBlock Text="{loc:Tr 不是纯待机缓存，也不等于可释放的全部内存。}" Style="{StaticResource Caption}"/></StackPanel>
            <StackPanel x:Name="CustomOptions" Visibility="{Binding CustomPopup, Converter={StaticResource Visible}}" IsEnabled="{Binding CanClean}"><TextBlock Text="{loc:Tr 高级整理}" Style="{StaticResource PageTitle}"/><TextBlock Text="{loc:Tr 全系统操作，可能短暂卡顿或增加磁盘活动。}" Style="{StaticResource Caption}" Margin="0,0,0,12"/><StackPanel Visibility="{Binding SystemComponentMissing, Converter={StaticResource Visible}}" Margin="0,0,0,12"><TextBlock Text="{loc:Tr 高级组件未安装}" Style="{StaticResource Caption}"/><Button Content="{loc:Tr 下载安装包}" Style="{StaticResource TextButton}" Command="{Binding Command}" CommandParameter="releases" HorizontalAlignment="Left"/></StackPanel><CheckBox x:Name="WorkingCheck" Content="{loc:Tr 裁剪全系统工作集}" Command="{Binding Command}" CommandParameter="selection"/><CheckBox x:Name="ModifiedCheck" Content="{loc:Tr 刷新修改页（可能增加磁盘活动）}" Command="{Binding Command}" CommandParameter="selection"/><CheckBox x:Name="StandbyCheck" Content="{loc:Tr 清理待机缓存}" Command="{Binding Command}" CommandParameter="selection"/><Button x:Name="CustomRunButton" IsEnabled="{Binding AdvancedAvailable}" Content="{loc:Tr 整理所选}" Style="{StaticResource PrimaryButton}" Command="{Binding Command}" CommandParameter="custom-run" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel>
            <StackPanel Visibility="{Binding ProcessPopup, Converter={StaticResource Visible}}"><TextBlock Text="{loc:Tr 进程读数}" Style="{StaticResource PageTitle}"/><TextBlock Text="{Binding ProcessDetail}" LineHeight="22"/><TextBlock Text="{loc:Tr 仅供诊断，不结束进程。}" Style="{StaticResource Caption}" Margin="0,12,0,0"/></StackPanel>
          </StackPanel></ScrollViewer>
        </Grid>
      </Border>
    </Popup>
  </Grid>
</Window>
