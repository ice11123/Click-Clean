<Window x:Class="ClickClean.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ClickClean"
        Title="Click-Clean 即清" Width="560" Height="620" MinWidth="440" MinHeight="560" WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/ClickClean;component/Assets/ClickClean.png"
        Background="{DynamicResource Bg}" FontFamily="Segoe UI, Microsoft YaHei UI" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <Style x:Key="UtilityButton" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,7"/><Setter Property="MinHeight" Value="32"/><Setter Property="FontSize" Value="12"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="ButtonShell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"><ContentPresenter.Resources><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Style></ContentPresenter.Resources></ContentPresenter>
        </Border>
        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonShell" Property="Opacity" Value="0.85"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonShell" Property="Opacity" Value="0.7"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonShell" Property="BorderBrush" Value="{DynamicResource Text}"/><Setter TargetName="ButtonShell" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonShell" Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource UtilityButton}"/>
    <Style TargetType="Expander">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
        <StackPanel>
          <ToggleButton x:Name="HeaderSite" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" HorizontalContentAlignment="Left" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
              <Border x:Name="HeaderFocus" BorderBrush="Transparent" BorderThickness="1" Padding="2,4" Background="Transparent">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <Path x:Name="Chevron" Data="M 3,2 L 7,6 L 3,10" Width="10" Height="10" Stretch="Uniform" Stroke="{DynamicResource Muted}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                  <ContentPresenter Grid.Column="1" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                </Grid>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="Data" Value="M 2,3 L 6,7 L 10,3"/></Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chevron" Property="Stroke" Value="{DynamicResource Text}"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="HeaderFocus" Property="BorderBrush" Value="{DynamicResource Text}"/><Setter TargetName="Chevron" Property="Stroke" Value="{DynamicResource Text}"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <ContentPresenter x:Name="ExpandBody" Visibility="Collapsed" ContentSource="Content" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
        </StackPanel>
        <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="ExpandBody" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="Description" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="19"/></Style>
    <Style x:Key="SectionRule" TargetType="Border"><Setter Property="Height" Value="1"/><Setter Property="Background" Value="{DynamicResource Line}"/><Setter Property="Margin" Value="0,16"/></Style>
    <Style x:Key="NavigationButton" TargetType="Button" BasedOn="{StaticResource UtilityButton}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Padding" Value="8,8"/><Setter Property="MinHeight" Value="34"/><Setter Property="FontSize" Value="13"/></Style>
    <Style x:Key="ProjectLink" TargetType="Button" BasedOn="{StaticResource UtilityButton}"><Setter Property="Padding" Value="4,6"/><Setter Property="MinHeight" Value="30"/><Setter Property="FontSize" Value="11"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="ToolTipService.InitialShowDelay" Value="500"/><Setter Property="ToolTipService.BetweenShowDelay" Value="0"/></Style>
    <Style x:Key="LinkGlyph" TargetType="Path"><Setter Property="Width" Value="13"/><Setter Property="Height" Value="13"/><Setter Property="Stretch" Value="Uniform"/><Setter Property="Stroke" Value="{DynamicResource Muted}"/><Setter Property="StrokeThickness" Value="1.6"/><Setter Property="StrokeStartLineCap" Value="Round"/><Setter Property="StrokeEndLineCap" Value="Round"/><Setter Property="StrokeLineJoin" Value="Round"/><Setter Property="Margin" Value="0,0,7,0"/></Style>
  </Window.Resources>
  <Grid Margin="22,18,22,12">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid x:Name="Header" Margin="0,0,0,16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Image Width="30" Height="30" Margin="0,0,9,0" Source="pack://application:,,,/ClickClean;component/Assets/ClickClean.png" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Click-Clean 图标"/>
        <StackPanel><TextBlock Text="Click-Clean" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="即清 · 内存工具" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,2,0,0"/></StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="HistoryButton" Content="历史" Click="History_Click" Margin="0,0,4,0" Padding="10,6" Background="Transparent" BorderBrush="Transparent" AutomationProperties.Name="查看整理历史" ToolTip="查看最近 30 次整理记录"/>
        <Button x:Name="SettingsButton" Content="设置" Click="Settings_Click" Padding="10,6" Background="Transparent" BorderBrush="Transparent" AutomationProperties.Name="打开设置" ToolTip="外观、自动清理、更新与关于"/>
      </StackPanel>
    </Grid>
    <ScrollViewer x:Name="MainContent" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
      <StackPanel Margin="0,0,5,0">
        <Border x:Name="HomeUpdateBanner" Visibility="Collapsed" Background="{DynamicResource Tint}" BorderBrush="{DynamicResource DetailAccent}" BorderThickness="3,0,0,0" Padding="10,8" Margin="0,0,0,16" AutomationProperties.LiveSetting="Polite">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="HomeUpdateText" Text="发现新版本" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <Button x:Name="HomeUpdateButton" Grid.Column="1" Content="下载更新" Click="HomeUpdate_Click" Padding="10,5" MinHeight="30" Background="Transparent" BorderBrush="{DynamicResource Line}"/>
          </Grid>
        </Border>
        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,1" Padding="0,18,0,18">
          <StackPanel>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Path Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource DetailAccent}" StrokeThickness="1.6" Margin="0,0,8,0" Data="M 9,7 L 33,7 33,27 9,27 Z M 14,12 L 28,12 28,22 14,22 Z M 14,2 L 14,7 M 21,2 L 21,7 M 28,2 L 28,7 M 14,27 L 14,32 M 21,27 L 21,32 M 28,27 L 28,32 M 4,12 L 9,12 M 4,22 L 9,22 M 33,12 L 38,12 M 33,22 L 38,22"/>
                <TextBlock Text="内存" FontSize="14" FontWeight="SemiBold"/>
              </StackPanel>
              <TextBlock x:Name="AdminText" Grid.Column="1" Text="管理员已就绪" FontSize="10" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
            </Grid>
            <Grid Margin="0,14,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Margin="0,0,25,0">
                  <StackPanel Orientation="Horizontal"><TextBlock x:Name="LoadText" Text="—" FontSize="32" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"/><TextBlock Text="%" FontSize="14" Foreground="{DynamicResource Muted}" VerticalAlignment="Bottom" Margin="3,0,0,5"/></StackPanel>
                  <TextBlock Text="正在使用" FontSize="11" Foreground="{DynamicResource Muted}"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock x:Name="AvailableText" Text="—" FontSize="16" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"/>
                  <TextBlock Text="可用内存" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,5,0,0"/>
                </StackPanel>
              </StackPanel>
              <Button x:Name="CleanButton" Grid.Column="1" Content="检查并整理" Click="Clean_Click" VerticalAlignment="Center" Padding="14,8" MinHeight="36" Margin="10,0,0,0" Background="{DynamicResource Accent}" Foreground="{DynamicResource AccentText}" BorderBrush="{DynamicResource Accent}" AutomationProperties.Name="检查内存压力，必要时尝试整理待机缓存"/>
            </Grid>
            <ProgressBar x:Name="MemoryBar" Height="4" Maximum="100" Foreground="{DynamicResource Text}" Background="{DynamicResource Line}" AutomationProperties.Name="物理内存使用率"/>
            <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal"><TextBlock Text="已用 " FontSize="11" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="UsedText" Text="—" FontSize="11" Foreground="{DynamicResource Muted}" Typography.NumeralAlignment="Tabular"/><TextBlock Text=" / " FontSize="11" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="TotalText" Text="—" FontSize="11" Foreground="{DynamicResource Muted}" Typography.NumeralAlignment="Tabular"/></StackPanel>
              <Button x:Name="CancelButton" Grid.Column="1" Content="取消后续" Visibility="Collapsed" Click="Cancel_Click" Padding="8,3" MinHeight="26"/>
            </Grid>
          </StackPanel>
        </Border>
        <TextBlock x:Name="StatusText" Text="低压力时跳过；必要时仅尝试整理待机缓存。" Style="{StaticResource Description}" Margin="0,12,0,16"/>
        <Border x:Name="ResultCard" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,0,0,16" Visibility="Collapsed" Margin="0,0,0,16">
          <StackPanel>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="ResultTitle" Text="最近结果" FontSize="12" FontWeight="SemiBold"/><TextBlock x:Name="ResultMeta" Grid.Column="1" FontSize="10" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/></Grid>
            <Expander Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,7,0,0" AutomationProperties.Name="展开最近整理结果详情">
              <Expander.Header><TextBlock x:Name="ResultDelta" FontSize="13" Typography.NumeralAlignment="Tabular"/></Expander.Header>
              <StackPanel Margin="0,8,0,0"><TextBlock x:Name="ResultError" Style="{StaticResource Description}"/><TextBlock x:Name="ResultDetails" Style="{StaticResource Description}" Margin="0,6,0,0"/></StackPanel>
            </Expander>
          </StackPanel>
        </Border>
        <Expander x:Name="Options" Header="高级手动整理" Foreground="{DynamicResource Text}" FontSize="12">
          <StackPanel Margin="0,12,0,0">
            <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="提交量 / 上限" Style="{StaticResource Description}"/><TextBlock x:Name="CommitText" Grid.Column="1" Text="—" FontSize="12" Typography.NumeralAlignment="Tabular"/></Grid>
            <TextBlock x:Name="AutomationSummary" Text="阈值清理：关闭    定时清理：关闭" Style="{StaticResource Description}" Margin="0,0,0,12"/>
            <TextBlock Text="所选项目仅由下方按钮执行，不属于默认整理流程。" Style="{StaticResource Description}" Margin="0,0,0,5"/>
            <CheckBox x:Name="WorkingCheck" Content="裁剪全系统工作集" IsChecked="True" Click="Selection_Click"/><CheckBox x:Name="ModifiedCheck" Content="刷新修改页（可能产生磁盘忙碌）" IsChecked="True" Click="Selection_Click"/><CheckBox x:Name="StandbyCheck" Content="清理待机缓存" IsChecked="True" Click="Selection_Click"/>
            <Button x:Name="CustomButton" Content="整理所选项目" Click="Custom_Click" HorizontalAlignment="Left" Margin="0,8,0,8"/>
            <TextBlock Text="高级操作作用于整个系统，可能短暂卡顿。可用内存变化不代表性能提升。" Style="{StaticResource Description}"/>
          </StackPanel>
        </Expander>
      </StackPanel>
    </ScrollViewer>
    <Grid x:Name="Footer" Grid.Row="2" Margin="0,14,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="原作者：离子怪" FontSize="11" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="VersionText" FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,3,0,0"/></StackPanel><Button Grid.Column="1" Content="桌面岛" Click="Island_Click" FontSize="11" MinHeight="30" Padding="8,5" Background="Transparent" BorderBrush="Transparent" ToolTip="显示或收起任务栏上方的薄胶囊"/></Grid>
      <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="-4,5,0,0">
        <Button x:Name="RepositoryLinkButton" Tag="repository" Click="ProjectLink_Click" Style="{StaticResource ProjectLink}" Margin="0,0,6,0" ToolTip="GitHub 开源仓库 · https://github.com/ice11123/Click-Clean" AutomationProperties.Name="打开 Click-Clean GitHub 开源仓库"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource LinkGlyph}" Data="M 6,7 L 6,17 M 6,11 C 6,15 18,12 18,7 M 6,2 A 2.5,2.5 0 1 1 5.99,2 M 18,2 A 2.5,2.5 0 1 1 17.99,2 M 6,17 A 2.5,2.5 0 1 1 5.99,17"/><TextBlock Text="开源仓库" VerticalAlignment="Center" FontSize="11"/></StackPanel></Button>
        <Button x:Name="BlogLinkButton" Tag="blog" Click="ProjectLink_Click" Style="{StaticResource ProjectLink}" Margin="0,0,6,0" ToolTip="离子怪博客 · https://ice11123.github.io/blog_test2/" AutomationProperties.Name="打开离子怪博客"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource LinkGlyph}" Data="M 3,3 L 10,3 Q 12,3 12,5 Q 12,3 14,3 L 21,3 21,20 14,20 Q 12,20 12,22 Q 12,20 10,20 L 3,20 Z M 12,5 L 12,21 M 6,7 L 9,7 M 6,11 L 9,11 M 15,7 L 18,7 M 15,11 L 18,11"/><TextBlock Text="离子怪博客" VerticalAlignment="Center" FontSize="11"/></StackPanel></Button>
        <Button x:Name="AuthorLinkButton" Tag="author" Click="ProjectLink_Click" Style="{StaticResource ProjectLink}" ToolTip="离子怪 GitHub 首页 · https://github.com/ice11123" AutomationProperties.Name="打开离子怪 GitHub 个人主页"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource LinkGlyph}" Data="M 12,2 A 4,4 0 1 1 11.99,2 M 3,22 C 3,12 21,12 21,22 Z"/><TextBlock Text="GitHub 主页" VerticalAlignment="Center" FontSize="11"/></StackPanel></Button>
      </StackPanel>
    </Grid>
    <Border x:Name="Overlay" Grid.RowSpan="3" Background="{DynamicResource Bg}" Padding="0" Visibility="Collapsed" Panel.ZIndex="10" KeyboardNavigation.TabNavigation="Cycle">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="← 返回" Click="CloseOverlay_Click" VerticalAlignment="Center" Padding="8,6" Background="Transparent" BorderBrush="Transparent" ToolTip="返回主窗口（Esc）"/><TextBlock x:Name="OverlayTitle" Grid.Column="1" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,0,0"/></Grid>
        <Grid Grid.Row="1">
          <Grid x:Name="SettingsPanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,18"><UniformGrid Columns="4">
              <Button Content="外观" Tag="appearance" Click="SettingsTab_Click"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavigationButton}"><Style.Triggers><DataTrigger Binding="{Binding Visibility, ElementName=AppearanceSection}" Value="Visible"><Setter Property="Background" Value="{DynamicResource Tint}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
              <Button Content="自动清理" Tag="automation" Click="SettingsTab_Click"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavigationButton}"><Style.Triggers><DataTrigger Binding="{Binding Visibility, ElementName=AutomationSection}" Value="Visible"><Setter Property="Background" Value="{DynamicResource Tint}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
              <Button Content="更新" Tag="updates" Click="SettingsTab_Click"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavigationButton}"><Style.Triggers><DataTrigger Binding="{Binding Visibility, ElementName=UpdatesSection}" Value="Visible"><Setter Property="Background" Value="{DynamicResource Tint}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
              <Button Content="关于" Tag="about" Click="SettingsTab_Click"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavigationButton}"><Style.Triggers><DataTrigger Binding="{Binding Visibility, ElementName=AboutSection}" Value="Visible"><Setter Property="Background" Value="{DynamicResource Tint}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
            </UniformGrid></Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly"><StackPanel Margin="0,0,5,8">
              <StackPanel x:Name="AppearanceSection">
                <TextBlock Text="外观与行为" Style="{StaticResource SectionTitle}"/><TextBlock Text="选择外观，安排启动与收起方式。" Style="{StaticResource Description}" Margin="0,0,0,23"/>
                <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions><TextBlock Text="界面主题" VerticalAlignment="Center"/><ComboBox x:Name="ThemeCombo" Grid.Column="1" SelectionChanged="Theme_Changed" AutomationProperties.Name="选择主题"><ComboBoxItem Content="跟随系统"/><ComboBoxItem Content="浅色"/><ComboBoxItem Content="深色"/></ComboBox></Grid>
                <CheckBox x:Name="MotionCheck" Style="{StaticResource Switch}" Content="减少动画" Click="Preferences_Click" Margin="0,5,0,0"/>
                <Border Style="{StaticResource SectionRule}"/><TextBlock Text="启动与后台" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <CheckBox x:Name="StartupCheck" Style="{StaticResource Switch}" Content="登录后启动到托盘" Click="Startup_Click"/><TextBlock Text="以管理员权限运行，仅对当前账户生效。" Style="{StaticResource Description}" Margin="0,2,50,12"/>
                <CheckBox x:Name="CloseToTrayCheck" Style="{StaticResource Switch}" Content="关闭主窗口时收起到托盘" Click="Preferences_Click"/><TextBlock Text="最小化仍保留任务栏。托盘可以打开、整理或完全退出。" Style="{StaticResource Description}" Margin="0,2,50,0"/>
                <Border Style="{StaticResource SectionRule}"/><CheckBox x:Name="IslandCheck" Style="{StaticResource Switch}" Content="底部整理岛" Click="Preferences_Click"/><TextBlock Text="靠近主屏任务栏上方中央时浮出，点击检查压力并按需整理待机缓存。离开后收回，全屏应用期间不浮出。" Style="{StaticResource Description}" Margin="0,2,50,0"/>
              </StackPanel>
              <StackPanel x:Name="AutomationSection" Visibility="Collapsed">
                <TextBlock Text="自动整理" Style="{StaticResource SectionTitle}"/><TextBlock Text="默认关闭。阈值或定时触发后先检查压力，仅尝试整理待机缓存；低压力跳过，整理后进入冷却，休眠恢复不补跑。" Style="{StaticResource Description}" Margin="0,0,0,20"/>
                <CheckBox x:Name="ThresholdCheck" Style="{StaticResource Switch}" Content="启用阈值清理"/>
                <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="已用内存阈值" FontSize="12"/><TextBlock Text="60～98%" Style="{StaticResource Description}"/><TextBox x:Name="ThresholdInput" IsEnabled="{Binding IsChecked, ElementName=ThresholdCheck}" AutomationProperties.Name="已用内存阈值百分比"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="持续超限" FontSize="12"/><TextBlock Text="15～600 秒" Style="{StaticResource Description}"/><TextBox x:Name="SustainInput" IsEnabled="{Binding IsChecked, ElementName=ThresholdCheck}" AutomationProperties.Name="持续超限秒数"/></StackPanel></Grid>
                <Border Style="{StaticResource SectionRule}" Margin="0,9,0,12"/><CheckBox x:Name="TimerCheck" Style="{StaticResource Switch}" Content="启用定时清理"/>
                <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="整理间隔" FontSize="12"/><TextBlock Text="15～1440 分钟" Style="{StaticResource Description}"/><TextBox x:Name="IntervalInput" IsEnabled="{Binding IsChecked, ElementName=TimerCheck}" AutomationProperties.Name="定时清理间隔分钟"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="清理冷却" FontSize="12"/><TextBlock Text="5～240 分钟" Style="{StaticResource Description}"/><TextBox x:Name="CooldownInput" AutomationProperties.Name="清理冷却分钟"/></StackPanel></Grid>
                <Border Style="{StaticResource SectionRule}" Margin="0,9,0,15"/><CheckBox x:Name="FullAutoCheck" IsEnabled="False"><TextBlock Text="旧版全三步自动整理（已停用）" TextWrapping="Wrap"/></CheckBox>
                <TextBlock Text="自动模式不会裁剪全系统工作集或刷新修改页，也不保证降低内存占用或提速。旧版全三步自动策略需重新保存确认后才恢复运行。" Style="{StaticResource Description}" Margin="0,5,0,18"/>
                <Button Content="确认保守策略并保存" Click="SaveAutomation_Click" HorizontalAlignment="Left"/><TextBlock x:Name="AutomationFeedback" Style="{StaticResource Description}" Margin="0,12,0,0"/><TextBlock Text="连续自动失败 3 次会暂停，重新保存设置可恢复。软件完全退出后不会执行自动清理。" Style="{StaticResource Description}" Margin="0,14,0,0"/>
              </StackPanel>
              <StackPanel x:Name="UpdatesSection" Visibility="Collapsed">
                <TextBlock Text="版本与更新" Style="{StaticResource SectionTitle}"/><TextBlock Text="从正式发布获取更新，由你决定下载和生效时机。" Style="{StaticResource Description}" Margin="0,0,0,20"/>
                <CheckBox x:Name="UpdateCheck" Style="{StaticResource Switch}" Content="自动检查正式版本" Click="Preferences_Click"/><CheckBox x:Name="DownloadCheck" Visibility="Collapsed" IsEnabled="False"/><CheckBox x:Name="ApplyHiddenCheck" Visibility="Collapsed" IsEnabled="False"/>
                <TextBlock Text="发现新版本会在首页提示。下载和重启更新均由你点击确认；不会自动下载或自动应用更新。" Style="{StaticResource Description}" Margin="0,12,0,0"/><Border Style="{StaticResource SectionRule}"/>
                <WrapPanel><Button x:Name="CheckUpdateButton" Content="检查更新" Click="CheckUpdate_Click" Margin="0,0,8,8"/><Button x:Name="DownloadUpdateButton" Content="下载更新" Click="DownloadUpdate_Click" Margin="0,0,8,8" Visibility="Collapsed"/><Button x:Name="ApplyUpdateButton" Content="重启并更新" Click="ApplyUpdate_Click" Margin="0,0,0,8" Visibility="Collapsed"/></WrapPanel>
                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,12,0,0"><TextBlock x:Name="UpdateFeedback" Text="尚未检查更新" Style="{StaticResource Description}"/></Border>
              </StackPanel>
              <StackPanel x:Name="AboutSection" Visibility="Collapsed">
                <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><Image Width="36" Height="36" Source="pack://application:,,,/ClickClean;component/Assets/ClickClean.png" Margin="0,0,14,0" RenderOptions.BitmapScalingMode="HighQuality"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Click-Clean 即清" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="AboutVersion" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Grid>
                <TextBlock Text="原作者：离子怪" FontWeight="SemiBold" Margin="0,0,0,10"/><TextBlock Text="Windows 11 全系统内存整理工具。可用内存变化包含其他程序活动的影响，不能作为提速证明。" Style="{StaticResource Description}"/>
                <Border Style="{StaticResource SectionRule}"/><TextBlock Text="开源与许可" FontWeight="SemiBold" Margin="0,0,0,10"/><TextBlock Text="GPL-3.0-only · Copyright © 2026 离子怪（ice11123）及贡献者。按许可证允许复制、修改与分发；本软件不提供担保。" Style="{StaticResource Description}" Margin="0,0,0,15"/>
                <WrapPanel><Button Content="开源仓库" Click="Repository_Click" Margin="0,0,8,0"/><Button Content="查看许可证" Click="License_Click"/></WrapPanel>
                <Border Style="{StaticResource SectionRule}"/><TextBlock Text="诊断与本地数据" FontWeight="SemiBold" Margin="0,0,0,10"/><TextBlock Text="诊断日志可帮助排查问题。清除本地数据将删除即清的设置、历史及日志并退出。" Style="{StaticResource Description}" Margin="0,0,0,12"/>
                <WrapPanel><Button Content="导出诊断日志" Click="Export_Click" Margin="0,0,8,8"/><Button Content="清除本地用户数据" Click="DeleteData_Click" Margin="0,0,0,8"/></WrapPanel><Button Content="完全退出即清" Click="Exit_Click" HorizontalAlignment="Left" Margin="0,10,0,0" Background="Transparent"/>
              </StackPanel>
            </StackPanel></ScrollViewer>
          </Grid>
          <Grid x:Name="HistoryPanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,0,0,18" Margin="0,0,0,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="整理记录" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="本地保留最近 30 次 · 可用内存变化不等于性能提升" Style="{StaticResource Description}" Margin="0,6,12,0"/></StackPanel><Button Grid.Column="1" Content="清空记录" Click="ClearHistory_Click" VerticalAlignment="Top" Padding="12,9"/></Grid></Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly"><StackPanel x:Name="HistoryItems" Margin="0,0,5,0"/></ScrollViewer>
          </Grid>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
