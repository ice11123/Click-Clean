<Window x:Class="ClickClean.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:ClickClean.Views"
        Title="Click-Clean 即清" Width="560" Height="600" MinWidth="440" MinHeight="540" WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/ClickClean;component/Assets/ClickClean.png" Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI, Microsoft YaHei UI" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Grid x:Name="LayoutRoot" Margin="24,8,24,14" MaxWidth="720">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid x:Name="Header" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Image Source="pack://application:,,,/ClickClean;component/Assets/ClickClean.png" Width="20" Height="20" Margin="0,0,6,0" AutomationProperties.Name="Click-Clean 原图标"/>
      <Grid Grid.Column="1"><Button x:Name="OverviewButton" Content="概览" Command="{Binding Command}" CommandParameter="overview" AutomationProperties.Name="切换到概览"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding Overview}" Value="True"><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Border Height="2" Background="{DynamicResource Accent}" VerticalAlignment="Bottom" Margin="14,0" Visibility="{Binding Overview, Converter={StaticResource Visible}}"/></Grid>
      <Grid Grid.Column="2"><Button x:Name="HistoryButton" Content="记录" Command="{Binding Command}" CommandParameter="history" AutomationProperties.Name="查看整理记录"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding Records}" Value="True"><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Border Height="2" Background="{DynamicResource Accent}" VerticalAlignment="Bottom" Margin="14,0" Visibility="{Binding Records, Converter={StaticResource Visible}}"/></Grid>
      <Grid Grid.Column="3"><Button x:Name="DiagnosticsButton" Content="诊断" Command="{Binding Command}" CommandParameter="diagnostics" AutomationProperties.Name="查看内存增长"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding Diagnostics}" Value="True"><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Border Height="2" Background="{DynamicResource Accent}" VerticalAlignment="Bottom" Margin="14,0" Visibility="{Binding Diagnostics, Converter={StaticResource Visible}}"/></Grid>
      <TextBlock Grid.Column="4" Text="模拟预览" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="{Binding Preview, Converter={StaticResource Visible}}"/><Grid Grid.Column="5"><Button x:Name="SettingsButton" Content="⚙ 设置" Command="{Binding Command}" CommandParameter="settings" AutomationProperties.Name="打开设置"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding SettingsPage}" Value="True"><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Border Height="2" Background="{DynamicResource Accent}" VerticalAlignment="Bottom" Margin="14,0" Visibility="{Binding SettingsPage, Converter={StaticResource Visible}}"/></Grid>
    </Grid>
    <Grid Grid.Row="1" Margin="0,14,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
      <Border x:Name="HomeUpdateBanner" Visibility="{Binding HomeBannerVisible, Converter={StaticResource Visible}}" Background="{DynamicResource Tint}" BorderBrush="{DynamicResource DetailAccent}" BorderThickness="3,0,0,0" Padding="10,7" Margin="0,0,0,16" AutomationProperties.LiveSetting="Polite">
        <Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="HomeUpdateText" Text="{Binding UpdateText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding UpdateText}" VerticalAlignment="Center" FontSize="12" Margin="0,0,8,0"/>
          <Button x:Name="HomeUpdateButton" Grid.Column="1" Content="{Binding UpdateButton}" IsEnabled="{Binding UpdateActionEnabled}" Style="{StaticResource TextButton}" Command="{Binding Command}" CommandParameter="home-update"/>
          <Button x:Name="HomeCancelUpdate" Grid.Column="2" Content="取消" Style="{StaticResource TextButton}" Visibility="{Binding UpdateBusy, Converter={StaticResource Visible}}" Command="{Binding Command}" CommandParameter="cancel-update"/>
          <ProgressBar x:Name="HomeUpdateProgress" Grid.Row="1" Grid.ColumnSpan="3" Value="{Binding DownloadProgress}" IsIndeterminate="{Binding DownloadIndeterminate}" Visibility="{Binding Downloading, Converter={StaticResource Visible}}" Maximum="100" Height="3" Margin="0,5,0,0" Foreground="{DynamicResource Accent}" AutomationProperties.Name="实际更新下载进度"/>
        </Grid>
      </Border>
      <Border Grid.Row="1" x:Name="RecoveryBanner" Visibility="{Binding RecoveryVisible, Converter={StaticResource Visible}}" Background="{DynamicResource Tint}" Padding="12" Margin="0,0,0,16"><StackPanel><TextBlock Text="上次更新未完成启动，可重试或从发行历史恢复安装。" Style="{StaticResource Caption}"/><Button Content="打开发行历史" Style="{StaticResource TextButton}" Command="{Binding Command}" CommandParameter="releases" HorizontalAlignment="Left"/></StackPanel></Border>
      <Grid Grid.Row="2">
        <views:OverviewView x:Name="OverviewPane" Visibility="{Binding Overview, Converter={StaticResource Visible}}"/>
        <views:HistoryView x:Name="HistoryPane" Visibility="{Binding Records, Converter={StaticResource Visible}}"/>
        <views:DiagnosticsView x:Name="DiagnosticsPane" Visibility="{Binding Diagnostics, Converter={StaticResource Visible}}"/>
        <views:SettingsView x:Name="SettingsPane" Visibility="{Binding SettingsPage, Converter={StaticResource Visible}}"/>
      </Grid>
    </Grid>
    <Border x:Name="Footer" Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,12,0,0">
      <StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="原作者：离子怪" Style="{StaticResource Caption}"/><TextBlock Grid.Column="1" Text="{Binding Version}" Style="{StaticResource Caption}"/></Grid>
        <WrapPanel Margin="-3,4,0,0">
          <Button x:Name="RepositoryLinkButton" Style="{StaticResource ProjectLink}" Command="{Binding Command}" CommandParameter="repository" Margin="0,0,12,0" ToolTip="https://github.com/ice11123/Click-Clean" AutomationProperties.Name="打开 Click-Clean GitHub 开源仓库"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource LinkGlyph}" Data="M 4,2 A 2,2 0 1 0 4,6 A 2,2 0 1 0 4,2 M 4,6 L 4,13 M 4,13 A 2,2 0 1 0 4,17 A 2,2 0 1 0 4,13 M 4,10 C 12,10 12,9 12,6 M 12,2 A 2,2 0 1 0 12,6 A 2,2 0 1 0 12,2"/><TextBlock Text="开源仓库" FontSize="12" Foreground="{DynamicResource Muted}"/></StackPanel></Button>
          <Button x:Name="BlogLinkButton" Style="{StaticResource ProjectLink}" Command="{Binding Command}" CommandParameter="blog" Margin="0,0,12,0" ToolTip="https://ice11123.github.io/blog_test2/" AutomationProperties.Name="打开离子怪博客"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource LinkGlyph}" Data="M 2,3 Q 6,1 10,4 Q 14,1 18,3 L 18,16 Q 14,14 10,17 Q 6,14 2,16 Z M 10,4 L 10,17"/><TextBlock Text="离子怪博客" FontSize="12" Foreground="{DynamicResource Muted}"/></StackPanel></Button>
          <Button x:Name="AuthorLinkButton" Style="{StaticResource ProjectLink}" Command="{Binding Command}" CommandParameter="author" ToolTip="https://github.com/ice11123" AutomationProperties.Name="打开离子怪 GitHub 首页"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource LinkGlyph}" Data="M 10,2 A 3.5,3.5 0 1 0 10,9 A 3.5,3.5 0 1 0 10,2 M 3,18 L 3,16 Q 3,11 10,11 Q 17,11 17,16 L 17,18 Z"/><TextBlock Text="GitHub 首页" FontSize="12" Foreground="{DynamicResource Muted}"/></StackPanel></Button>
        </WrapPanel>
      </StackPanel>
    </Border>
    <Popup x:Name="DetailsPopup" Placement="Bottom" AllowsTransparency="True" StaysOpen="False" DataContext="{Binding}">
      <Border x:Name="PopupFrame" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="16" Width="460" KeyboardNavigation.TabNavigation="Cycle">
        <Border.RenderTransform><TranslateTransform x:Name="PopupShift"/></Border.RenderTransform>
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><Button Content="关闭 ×" Style="{StaticResource TextButton}" HorizontalAlignment="Right" Command="{Binding Command}" CommandParameter="close-popup" AutomationProperties.Name="关闭详情"/>
          <ScrollViewer x:Name="PopupScroll" Grid.Row="1" MaxHeight="380"><StackPanel>
            <views:ResultDetailsView Visibility="{Binding ResultPopup, Converter={StaticResource Visible}}"/>
            <StackPanel Visibility="{Binding MemoryPopup, Converter={StaticResource Visible}}"><TextBlock Text="内存详情" Style="{StaticResource PageTitle}"/><TextBlock Text="提交量 / 上限" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Commit}" Margin="0,6,0,16" Typography.NumeralAlignment="Tabular"/><TextBlock Text="系统缓存（含系统工作集）" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Cache}" Margin="0,6,0,8"/><TextBlock Text="不是纯待机缓存，也不等于可释放的全部内存。" Style="{StaticResource Caption}"/></StackPanel>
            <StackPanel x:Name="CustomOptions" Visibility="{Binding CustomPopup, Converter={StaticResource Visible}}" IsEnabled="{Binding CanClean}"><TextBlock Text="自定义步骤" Style="{StaticResource PageTitle}"/><TextBlock Text="仅改变此次自定义整理。一键整理默认执行全部三步。" Style="{StaticResource Caption}" Margin="0,0,0,12"/><CheckBox x:Name="WorkingCheck" Content="裁剪全系统工作集" Command="{Binding Command}" CommandParameter="selection"/><CheckBox x:Name="ModifiedCheck" Content="刷新修改页（可能增加磁盘活动）" Command="{Binding Command}" CommandParameter="selection"/><CheckBox x:Name="StandbyCheck" Content="清理待机缓存" Command="{Binding Command}" CommandParameter="selection"/><Button x:Name="CustomRunButton" Content="整理所选" Style="{StaticResource PrimaryButton}" Command="{Binding Command}" CommandParameter="custom-run" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel>
            <StackPanel Visibility="{Binding ProcessPopup, Converter={StaticResource Visible}}"><TextBlock Text="进程读数" Style="{StaticResource PageTitle}"/><TextBlock Text="{Binding ProcessDetail}" LineHeight="22"/><TextBlock Text="仅供诊断，不结束进程。" Style="{StaticResource Caption}" Margin="0,12,0,0"/></StackPanel>
          </StackPanel></ScrollViewer>
        </Grid>
      </Border>
    </Popup>
  </Grid>
</Window>
