<Window x:Class="ClickClean.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ClickClean"
        Title="Click-Clean 即清" Width="640" Height="820" MinWidth="440" MinHeight="560" WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/ClickClean;component/Assets/ClickClean.png"
        Background="{DynamicResource Bg}" FontFamily="Segoe UI, Microsoft YaHei UI" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="FontSize" Value="20"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="Description" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="19"/></Style>
    <Style x:Key="SectionRule" TargetType="Border"><Setter Property="Height" Value="1"/><Setter Property="Background" Value="{DynamicResource Line}"/><Setter Property="Margin" Value="0,20"/></Style>
    <Style x:Key="NavigationButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Padding" Value="6,10"/><Setter Property="MinHeight" Value="42"/><Setter Property="FontSize" Value="13"/></Style>
    <Style x:Key="ProjectLink" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="7,9"/><Setter Property="MinHeight" Value="38"/><Setter Property="FontSize" Value="11"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="ToolTipService.InitialShowDelay" Value="500"/><Setter Property="ToolTipService.BetweenShowDelay" Value="0"/></Style>
    <Style x:Key="LinkGlyph" TargetType="Path"><Setter Property="Width" Value="17"/><Setter Property="Height" Value="17"/><Setter Property="Stretch" Value="Uniform"/><Setter Property="Stroke" Value="{DynamicResource Accent}"/><Setter Property="StrokeThickness" Value="1.6"/><Setter Property="StrokeStartLineCap" Value="Round"/><Setter Property="StrokeEndLineCap" Value="Round"/><Setter Property="StrokeLineJoin" Value="Round"/><Setter Property="Margin" Value="0,0,7,0"/></Style>
  </Window.Resources>
  <Grid Margin="24,22,24,16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid x:Name="Header" Margin="0,0,0,20">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Image Width="42" Height="42" Margin="0,0,12,0" Source="pack://application:,,,/ClickClean;component/Assets/ClickClean.png" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Click-Clean 图标"/>
        <StackPanel><TextBlock Text="Click-Clean" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="即清 / 内存整理" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,2,0,0"/></StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="HistoryButton" Content="历史" Click="History_Click" Margin="0,0,6,0" Padding="12,9" Background="Transparent" AutomationProperties.Name="查看整理历史" ToolTip="查看最近 30 次整理记录"/>
        <Button x:Name="SettingsButton" Content="设置" Click="Settings_Click" Padding="12,9" Background="Transparent" AutomationProperties.Name="打开设置" ToolTip="外观、自动清理、更新与关于"/>
      </StackPanel>
    </Grid>
    <ScrollViewer x:Name="MainContent" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
      <StackPanel Margin="0,0,5,0">
        <Border Background="{DynamicResource Surface}" CornerRadius="22" BorderBrush="{DynamicResource Line}" BorderThickness="1">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border Background="{DynamicResource Tint}" CornerRadius="21,21,0,0" Padding="23,20,23,18">
              <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="{DynamicResource Accent}" Margin="0,0,8,0"/><TextBlock Text="物理内存" FontSize="13" FontWeight="SemiBold"/></StackPanel>
                  <TextBlock x:Name="AdminText" Grid.Column="1" Text="管理员已就绪" FontSize="10" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                </Grid>
                <Grid Grid.Row="1" Margin="0,14,0,17"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <StackPanel Orientation="Horizontal"><TextBlock x:Name="LoadText" Text="—" FontSize="66" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Typography.NumeralAlignment="Tabular"/><TextBlock Text="%" FontSize="24" Margin="5,0,0,12" VerticalAlignment="Bottom" Foreground="{DynamicResource Accent}"/></StackPanel>
                    <TextBlock Text="当前内存使用率" FontSize="11" Foreground="{DynamicResource Muted}" Margin="3,0,0,0"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Grid Width="42" Height="34" HorizontalAlignment="Right" Margin="0,0,0,10" IsHitTestVisible="False">
                      <Path Stroke="{DynamicResource Accent}" StrokeThickness="1.6" StrokeLineJoin="Round" Data="M 9,7 L 33,7 33,27 9,27 Z M 14,12 L 28,12 28,22 14,22 Z M 14,2 L 14,7 M 21,2 L 21,7 M 28,2 L 28,7 M 14,27 L 14,32 M 21,27 L 21,32 M 28,27 L 28,32 M 4,12 L 9,12 M 4,22 L 9,22 M 33,12 L 38,12 M 33,22 L 38,22"/>
                    </Grid>
                    <TextBlock x:Name="AvailableText" Text="—" FontSize="27" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" HorizontalAlignment="Right"/>
                    <TextBlock Text="可用内存" FontSize="11" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" Margin="0,3,0,0"/>
                  </StackPanel>
                </Grid>
                <ProgressBar x:Name="MemoryBar" Grid.Row="2" Height="7" Maximum="100" Foreground="{DynamicResource Accent}" Background="{DynamicResource Surface}" AutomationProperties.Name="物理内存使用率"/>
              </Grid>
            </Border>
            <Grid Grid.Row="1" Margin="23,16,23,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="1"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="已用 / 总量" FontSize="11" Foreground="{DynamicResource Muted}"/><StackPanel Orientation="Horizontal" Margin="0,6,0,0"><TextBlock x:Name="UsedText" Text="—" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"/><TextBlock Text=" / " Foreground="{DynamicResource Muted}"/><TextBlock x:Name="TotalText" Text="—" Typography.NumeralAlignment="Tabular"/></StackPanel></StackPanel>
              <Border Grid.Column="1" Background="{DynamicResource Line}"/>
              <StackPanel Grid.Column="2" HorizontalAlignment="Right"><TextBlock Text="提交量 / 上限" FontSize="11" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right"/><TextBlock x:Name="CommitText" Text="—" Margin="0,6,0,0" Typography.NumeralAlignment="Tabular" FontWeight="SemiBold"/></StackPanel>
            </Grid>
          </Grid>
        </Border>
        <Grid Margin="2,22,2,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="给内存一点呼吸空间" FontSize="18" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="全系统 · 三步整理" FontSize="10" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/></Grid>
        <UniformGrid Columns="3" Margin="2,14,2,14">
          <StackPanel Orientation="Horizontal"><TextBlock Text="01" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" Margin="0,0,8,0"/><TextBlock Text="裁剪工作集" FontSize="12"/></StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="02" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" Margin="0,0,8,0"/><TextBlock Text="刷新修改页" FontSize="12"/></StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock Text="03" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" Margin="0,0,8,0"/><TextBlock Text="清理待机缓存" FontSize="12"/></StackPanel>
        </UniformGrid>
        <Button x:Name="CleanButton" Content="即刻整理" Background="{DynamicResource Accent}" Foreground="{DynamicResource AccentText}" BorderBrush="{DynamicResource Accent}" FontSize="17" FontWeight="SemiBold" Height="52" Click="Clean_Click" AutomationProperties.Name="执行全系统三步内存整理"/>
        <Grid Margin="2,11,2,17"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="StatusText" Text="按需使用，缓存会随着使用重新建立。" Style="{StaticResource Description}" VerticalAlignment="Center"/>
          <Button x:Name="CancelButton" Grid.Column="1" Content="取消后续" Visibility="Collapsed" Click="Cancel_Click" Padding="10,5" MinHeight="30" Margin="8,0,0,0"/>
        </Grid>
        <Border x:Name="ResultCard" Style="{StaticResource Card}" Padding="18,16" Visibility="Collapsed" Margin="0,0,0,16">
          <StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="ResultTitle" Text="最近结果" FontWeight="SemiBold"/><TextBlock x:Name="ResultMeta" Grid.Column="1" FontSize="10" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/></Grid>
            <TextBlock x:Name="ResultDelta" FontSize="26" FontWeight="SemiBold" Margin="0,8,0,5"/><TextBlock x:Name="ResultError" Style="{StaticResource Description}"/>
            <Expander Header="查看步骤详情" Margin="0,10,0,0" Foreground="{DynamicResource Text}"><TextBlock x:Name="ResultDetails" Style="{StaticResource Description}" Margin="0,8,0,0"/></Expander>
          </StackPanel>
        </Border>
        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,1" Padding="2,13" Margin="0,0,0,13"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="自动清理" FontSize="12" FontWeight="SemiBold" Margin="0,0,18,0" VerticalAlignment="Center"/><TextBlock x:Name="AutomationSummary" Grid.Column="1" Text="阈值清理：关闭    定时清理：关闭" FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center"/></Grid></Border>
        <Expander x:Name="Options" Header="自定义整理项目" Foreground="{DynamicResource Text}" Margin="2,0,2,4"><StackPanel Margin="0,10,0,0">
          <CheckBox x:Name="WorkingCheck" Content="裁剪全系统工作集" IsChecked="True" Click="Selection_Click"/><CheckBox x:Name="ModifiedCheck" Content="刷新修改页（可能产生磁盘忙碌）" IsChecked="True" Click="Selection_Click"/><CheckBox x:Name="StandbyCheck" Content="清理待机缓存" IsChecked="True" Click="Selection_Click"/>
          <Button x:Name="CustomButton" Content="整理所选项目" Click="Custom_Click" Margin="0,8,0,8"/><TextBlock Text="作用于整个系统，可能短暂卡顿；可用内存变化不代表性能提升。" Style="{StaticResource Description}"/>
        </StackPanel></Expander>
      </StackPanel>
    </ScrollViewer>
    <Grid x:Name="Footer" Grid.Row="2" Margin="0,16,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="原作者：离子怪" FontSize="11" FontWeight="SemiBold"/><TextBlock x:Name="VersionText" FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,3,0,0"/></StackPanel><Button Grid.Column="1" Content="桌面岛" Click="Island_Click" FontSize="11" MinHeight="30" Padding="10,5" Background="Transparent" ToolTip="显示或收起任务栏上方的薄胶囊"/></Grid>
      <UniformGrid Grid.Row="1" Columns="3" Margin="0,11,0,0">
        <Button x:Name="RepositoryLinkButton" Tag="repository" Click="ProjectLink_Click" Style="{StaticResource ProjectLink}" Margin="0,0,6,0" ToolTip="GitHub 开源仓库 · https://github.com/ice11123/Click-Clean" AutomationProperties.Name="打开 Click-Clean GitHub 开源仓库"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource LinkGlyph}" Data="M 6,7 L 6,17 M 6,11 C 6,15 18,12 18,7 M 6,2 A 2.5,2.5 0 1 1 5.99,2 M 18,2 A 2.5,2.5 0 1 1 17.99,2 M 6,17 A 2.5,2.5 0 1 1 5.99,17"/><TextBlock Text="开源仓库" VerticalAlignment="Center" FontSize="11"/></StackPanel></Button>
        <Button x:Name="BlogLinkButton" Tag="blog" Click="ProjectLink_Click" Style="{StaticResource ProjectLink}" Margin="0,0,6,0" ToolTip="离子怪博客 · https://ice11123.github.io/blog_test2/" AutomationProperties.Name="打开离子怪博客"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource LinkGlyph}" Data="M 3,3 L 10,3 Q 12,3 12,5 Q 12,3 14,3 L 21,3 21,20 14,20 Q 12,20 12,22 Q 12,20 10,20 L 3,20 Z M 12,5 L 12,21 M 6,7 L 9,7 M 6,11 L 9,11 M 15,7 L 18,7 M 15,11 L 18,11"/><TextBlock Text="离子怪博客" VerticalAlignment="Center" FontSize="11"/></StackPanel></Button>
        <Button x:Name="AuthorLinkButton" Tag="author" Click="ProjectLink_Click" Style="{StaticResource ProjectLink}" ToolTip="离子怪 GitHub 首页 · https://github.com/ice11123" AutomationProperties.Name="打开离子怪 GitHub 个人主页"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource LinkGlyph}" Data="M 12,2 A 4,4 0 1 1 11.99,2 M 3,22 C 3,12 21,12 21,22 Z"/><TextBlock Text="GitHub 主页" VerticalAlignment="Center" FontSize="11"/></StackPanel></Button>
      </UniformGrid>
    </Grid>
    <Border x:Name="Overlay" Grid.RowSpan="3" Background="{DynamicResource Surface}" CornerRadius="22" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="22" Visibility="Collapsed" Panel.ZIndex="10" KeyboardNavigation.TabNavigation="Cycle">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="CLICK-CLEAN / 即清" FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,0,0,5"/><TextBlock x:Name="OverlayTitle" FontSize="27" FontWeight="SemiBold"/></StackPanel><Button Grid.Column="1" Content="返回" Click="CloseOverlay_Click" VerticalAlignment="Center" Padding="15,9" ToolTip="返回主窗口（Esc）"/></Grid>
        <Grid Grid.Row="1">
          <Grid x:Name="SettingsPanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Background="{DynamicResource Bg}" CornerRadius="12" Padding="4" Margin="0,0,0,24"><UniformGrid Columns="4">
              <Button Content="外观" Tag="appearance" Click="SettingsTab_Click"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavigationButton}"><Style.Triggers><DataTrigger Binding="{Binding Visibility, ElementName=AppearanceSection}" Value="Visible"><Setter Property="Background" Value="{DynamicResource Tint}"/><Setter Property="Foreground" Value="{DynamicResource Accent}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
              <Button Content="自动清理" Tag="automation" Click="SettingsTab_Click"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavigationButton}"><Style.Triggers><DataTrigger Binding="{Binding Visibility, ElementName=AutomationSection}" Value="Visible"><Setter Property="Background" Value="{DynamicResource Tint}"/><Setter Property="Foreground" Value="{DynamicResource Accent}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
              <Button Content="更新" Tag="updates" Click="SettingsTab_Click"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavigationButton}"><Style.Triggers><DataTrigger Binding="{Binding Visibility, ElementName=UpdatesSection}" Value="Visible"><Setter Property="Background" Value="{DynamicResource Tint}"/><Setter Property="Foreground" Value="{DynamicResource Accent}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
              <Button Content="关于" Tag="about" Click="SettingsTab_Click"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavigationButton}"><Style.Triggers><DataTrigger Binding="{Binding Visibility, ElementName=AboutSection}" Value="Visible"><Setter Property="Background" Value="{DynamicResource Tint}"/><Setter Property="Foreground" Value="{DynamicResource Accent}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
            </UniformGrid></Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly"><StackPanel Margin="0,0,5,8">
              <StackPanel x:Name="AppearanceSection">
                <TextBlock Text="让即清适合你的习惯" Style="{StaticResource SectionTitle}"/><TextBlock Text="选择外观，安排启动与收起方式。" Style="{StaticResource Description}" Margin="0,0,0,23"/>
                <TextBlock Text="界面主题" FontWeight="SemiBold" Margin="0,0,0,9"/><ComboBox x:Name="ThemeCombo" SelectionChanged="Theme_Changed" AutomationProperties.Name="选择主题"><ComboBoxItem Content="跟随系统"/><ComboBoxItem Content="浅色"/><ComboBoxItem Content="深色"/></ComboBox>
                <CheckBox x:Name="MotionCheck" Style="{StaticResource Switch}" Content="减少动画" Click="Preferences_Click" Margin="0,17,0,0"/>
                <Border Style="{StaticResource SectionRule}"/><TextBlock Text="启动与后台" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <CheckBox x:Name="StartupCheck" Style="{StaticResource Switch}" Content="登录后启动到托盘" Click="Startup_Click"/><TextBlock Text="以管理员权限运行，仅对当前账户生效。" Style="{StaticResource Description}" Margin="0,2,50,12"/>
                <CheckBox x:Name="CloseToTrayCheck" Style="{StaticResource Switch}" Content="关闭主窗口时收起到托盘" Click="Preferences_Click"/><TextBlock Text="最小化仍保留任务栏。托盘可以打开、整理或完全退出。" Style="{StaticResource Description}" Margin="0,2,50,0"/>
                <Border Style="{StaticResource SectionRule}"/><CheckBox x:Name="IslandCheck" Style="{StaticResource Switch}" Content="底部整理岛" Click="Preferences_Click"/><TextBlock Text="固定在主屏任务栏上方中央；鼠标靠近时浮出，点击即整理。鼠标离开后收回，全屏应用期间不浮出。" Style="{StaticResource Description}" Margin="0,2,50,0"/>
              </StackPanel>
              <StackPanel x:Name="AutomationSection" Visibility="Collapsed">
                <TextBlock Text="按条件，自动整理" Style="{StaticResource SectionTitle}"/><TextBlock Text="默认关闭。持续超限才触发，清理后进入冷却；休眠恢复不补跑积压任务。" Style="{StaticResource Description}" Margin="0,0,0,20"/>
                <CheckBox x:Name="ThresholdCheck" Style="{StaticResource Switch}" Content="启用阈值清理"/>
                <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="已用内存阈值" FontSize="12"/><TextBlock Text="60～98%" Style="{StaticResource Description}"/><TextBox x:Name="ThresholdInput" AutomationProperties.Name="已用内存阈值百分比"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="持续超限" FontSize="12"/><TextBlock Text="15～600 秒" Style="{StaticResource Description}"/><TextBox x:Name="SustainInput" AutomationProperties.Name="持续超限秒数"/></StackPanel></Grid>
                <Border Style="{StaticResource SectionRule}" Margin="0,9,0,12"/><CheckBox x:Name="TimerCheck" Style="{StaticResource Switch}" Content="启用定时清理"/>
                <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="整理间隔" FontSize="12"/><TextBlock Text="15～1440 分钟" Style="{StaticResource Description}"/><TextBox x:Name="IntervalInput" AutomationProperties.Name="定时清理间隔分钟"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="清理冷却" FontSize="12"/><TextBlock Text="5～240 分钟" Style="{StaticResource Description}"/><TextBox x:Name="CooldownInput" AutomationProperties.Name="清理冷却分钟"/></StackPanel></Grid>
                <Border Style="{StaticResource SectionRule}" Margin="0,9,0,15"/><CheckBox x:Name="FullAutoCheck"><TextBlock Text="自动模式执行全三步（含裁剪和刷盘）" TextWrapping="Wrap"/></CheckBox>
                <TextBlock Text="不勾选时仅清理待机缓存，不保证使用率下降。三步整理可能短暂卡顿或产生磁盘忙碌。" Style="{StaticResource Description}" Margin="0,5,0,18"/>
                <Button Content="保存自动清理设置" Click="SaveAutomation_Click" Background="{DynamicResource Accent}" Foreground="{DynamicResource AccentText}" BorderBrush="{DynamicResource Accent}"/><TextBlock x:Name="AutomationFeedback" Style="{StaticResource Description}" Margin="0,12,0,0"/><TextBlock Text="连续自动失败 3 次会暂停，重新保存设置可恢复。软件完全退出后不会执行自动清理。" Style="{StaticResource Description}" Margin="0,14,0,0"/>
              </StackPanel>
              <StackPanel x:Name="UpdatesSection" Visibility="Collapsed">
                <TextBlock Text="保持即清为最新版本" Style="{StaticResource SectionTitle}"/><TextBlock Text="从正式发布获取更新，由你决定下载和生效时机。" Style="{StaticResource Description}" Margin="0,0,0,20"/>
                <CheckBox x:Name="UpdateCheck" Style="{StaticResource Switch}" Content="自动检查正式版本" Click="Preferences_Click"/><CheckBox x:Name="DownloadCheck" Style="{StaticResource Switch}" Content="发现更新后后台下载" Click="Preferences_Click"/><CheckBox x:Name="ApplyHiddenCheck" Style="{StaticResource Switch}" Content="收起到托盘时自动重启更新" Click="Preferences_Click"/>
                <TextBlock Text="普通更新校验后短暂重启生效，无需安装向导。整理期间不会替换程序；安装机制变更等特殊升级会另行提示。" Style="{StaticResource Description}" Margin="0,12,0,0"/><Border Style="{StaticResource SectionRule}"/>
                <Button x:Name="CheckUpdateButton" Content="立即检查更新" Click="CheckUpdate_Click"/><Button x:Name="DownloadUpdateButton" Content="下载更新" Click="DownloadUpdate_Click" Margin="0,9,0,0" Visibility="Collapsed"/><Button x:Name="ApplyUpdateButton" Content="重启并更新" Click="ApplyUpdate_Click" Background="{DynamicResource Accent}" Foreground="{DynamicResource AccentText}" BorderBrush="{DynamicResource Accent}" Margin="0,9,0,0" Visibility="Collapsed"/>
                <Border Background="{DynamicResource Tint}" CornerRadius="12" Padding="16" Margin="0,18,0,0"><TextBlock x:Name="UpdateFeedback" Text="尚未检查更新" Style="{StaticResource Description}"/></Border>
              </StackPanel>
              <StackPanel x:Name="AboutSection" Visibility="Collapsed">
                <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><Image Width="54" Height="54" Source="pack://application:,,,/ClickClean;component/Assets/ClickClean.png" Margin="0,0,14,0" RenderOptions.BitmapScalingMode="HighQuality"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Click-Clean 即清" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="AboutVersion" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Grid>
                <TextBlock Text="原作者：离子怪" FontWeight="SemiBold" Margin="0,0,0,10"/><TextBlock Text="Windows 11 全系统内存整理工具。可用内存变化包含其他程序活动的影响，不能作为提速证明。" Style="{StaticResource Description}"/>
                <Border Style="{StaticResource SectionRule}"/><TextBlock Text="开源与许可" FontWeight="SemiBold" Margin="0,0,0,10"/><TextBlock Text="GPL-3.0-only · Copyright © 2026 离子怪（ice11123）及贡献者。按许可证允许复制、修改与分发；本软件不提供担保。" Style="{StaticResource Description}" Margin="0,0,0,15"/>
                <UniformGrid Columns="2"><Button Content="开源仓库" Click="Repository_Click" Margin="0,0,8,0"/><Button Content="查看许可证" Click="License_Click"/></UniformGrid>
                <Border Style="{StaticResource SectionRule}"/><TextBlock Text="诊断与本地数据" FontWeight="SemiBold" Margin="0,0,0,10"/><TextBlock Text="诊断日志可帮助排查问题。清除本地数据将删除即清的设置、历史及日志并退出。" Style="{StaticResource Description}" Margin="0,0,0,12"/>
                <Button Content="导出诊断日志" Click="Export_Click"/><Button Content="清除本地用户数据" Click="DeleteData_Click" Margin="0,9,0,0"/><Button Content="完全退出即清" Click="Exit_Click" Margin="0,22,0,0" Background="{DynamicResource Bg}"/>
              </StackPanel>
            </StackPanel></ScrollViewer>
          </Grid>
          <Grid x:Name="HistoryPanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,0,0,18" Margin="0,0,0,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="每次整理，都有据可查" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="本地保留最近 30 次 · 可用内存变化不等于性能提升" Style="{StaticResource Description}" Margin="0,6,12,0"/></StackPanel><Button Grid.Column="1" Content="清空记录" Click="ClearHistory_Click" VerticalAlignment="Top" Padding="12,9"/></Grid></Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly"><StackPanel x:Name="HistoryItems" Margin="0,0,5,0"/></ScrollViewer>
          </Grid>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
