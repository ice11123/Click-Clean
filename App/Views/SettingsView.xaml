<UserControl x:Class="ClickClean.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:ClickClean">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,16"><Button x:Name="SettingsBack" Content="{loc:Tr ← 返回}" HorizontalAlignment="Left" Style="{StaticResource TextButton}" Visibility="{Binding Settings.IsChild, Converter={StaticResource Visible}}" Command="{Binding Command}" CommandParameter="settings-back" Margin="-6,0,0,8"/><TextBlock x:Name="SettingsHeading" Text="{Binding Settings.Heading}" Style="{StaticResource PageTitle}"/></StackPanel>
    <ScrollViewer x:Name="SettingsScroll" Grid.Row="1"><StackPanel Margin="0,0,6,4">
      <StackPanel x:Name="SettingsIndex" Visibility="{Binding Settings.Index, Converter={StaticResource Visible}}">
        <Button x:Name="AppearanceIndex" Style="{StaticResource AcrylicOption}" Margin="0,0,0,8" Command="{Binding Command}" CommandParameter="settings-appearance"><StackPanel><TextBlock Text="{loc:Tr 常规与外观   ›}" FontWeight="SemiBold"/><TextBlock Text="{Binding Settings.AppearanceSummary}" Style="{StaticResource Caption}" Margin="0,6,0,0"/></StackPanel></Button>
        <Button Style="{StaticResource AcrylicOption}" Margin="0,0,0,8" Command="{Binding Command}" CommandParameter="settings-automation"><StackPanel><TextBlock Text="{loc:Tr 自动整理   ›}" FontWeight="SemiBold"/><TextBlock Text="{Binding Automatic}" Style="{StaticResource Caption}" Margin="0,6,0,0"/></StackPanel></Button>
        <Button Style="{StaticResource AcrylicOption}" Margin="0,0,0,8" Command="{Binding Command}" CommandParameter="settings-updates"><StackPanel><TextBlock Text="{loc:Tr 版本更新   ›}" FontWeight="SemiBold"/><TextBlock Text="{loc:Tr 手动下载与安装}" Style="{StaticResource Caption}" Margin="0,6,0,0"/></StackPanel></Button>
        <Button Style="{StaticResource AcrylicOption}" Margin="0,0,0,8" Command="{Binding Command}" CommandParameter="settings-about"><StackPanel><TextBlock Text="{loc:Tr 关于   ›}" FontWeight="SemiBold"/><TextBlock Text="{loc:Tr 作者与开源许可}" Style="{StaticResource Caption}" Margin="0,6,0,0"/></StackPanel></Button>
      </StackPanel>
      <StackPanel x:Name="AppearanceSection" Visibility="{Binding Settings.Appearance, Converter={StaticResource Visible}}">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="172"/></Grid.ColumnDefinitions><TextBlock Text="{loc:Tr 界面主题}" VerticalAlignment="Center"/><ComboBox x:Name="ThemeCombo" Grid.Column="1" SelectedIndex="{Binding Settings.Theme}" AutomationProperties.Name="{loc:Tr 界面主题}"><ComboBoxItem AutomationProperties.Name="{loc:Tr 浅色}"><StackPanel Orientation="Horizontal"><Border Background="#FFFFFF" BorderBrush="#A42A3A" BorderThickness="3,1,1,1" Width="16" Height="16" CornerRadius="3" Margin="0,0,8,0"/><TextBlock Text="{loc:Tr 浅色}"/></StackPanel></ComboBoxItem><ComboBoxItem AutomationProperties.Name="{loc:Tr 深色}"><StackPanel Orientation="Horizontal"><Border Background="#000000" BorderBrush="#7F2333" BorderThickness="3,1,1,1" Width="16" Height="16" CornerRadius="3" Margin="0,0,8,0"/><TextBlock Text="{loc:Tr 深色}"/></StackPanel></ComboBoxItem><ComboBoxItem AutomationProperties.Name="{loc:Tr 跟随系统}"><StackPanel Orientation="Horizontal"><Border BorderBrush="{DynamicResource Muted}" BorderThickness="1" Width="16" Height="16" CornerRadius="3" Margin="0,0,8,0"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#FFFFFF" Offset="0.49"/><GradientStop Color="#000000" Offset="0.5"/></LinearGradientBrush></Border.Background></Border><TextBlock Text="{loc:Tr 跟随系统}"/></StackPanel></ComboBoxItem></ComboBox></Grid>
        <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="172"/></Grid.ColumnDefinitions><TextBlock Text="{loc:Tr 语言 / Language}" VerticalAlignment="Center"/><ComboBox x:Name="LanguageCombo" Grid.Column="1" SelectedIndex="{Binding Settings.Language}" AutomationProperties.Name="{loc:Tr 语言 / Language}"><ComboBoxItem Content="简体中文"/><ComboBoxItem Content="English"/></ComboBox></Grid>
        <CheckBox x:Name="MotionCheck" Content="{loc:Tr 减少动画}" Style="{StaticResource Switch}" IsChecked="{Binding Settings.ReduceMotion}" Margin="0,12,0,0"/>
        <CheckBox x:Name="IslandCheck" Content="{loc:Tr 桌面整理岛}" Style="{StaticResource Switch}" IsChecked="{Binding Settings.Island}"/><TextBlock Text="{loc:Tr 靠近任务栏浮出，点击优化。}" Style="{StaticResource Caption}" Margin="0,2,40,0"/>
        <Border Style="{StaticResource Rule}"/><TextBlock Text="{loc:Tr 运行方式}" Style="{StaticResource GroupTitle}" Margin="0,0,0,8"/>
        <CheckBox x:Name="CloseToTrayCheck" Content="{loc:Tr 关闭主窗口时收起到托盘}" Style="{StaticResource Switch}" IsChecked="{Binding Settings.CloseToTray}"/><TextBlock Text="{loc:Tr 完全退出请使用托盘菜单。}" Style="{StaticResource Caption}" Margin="0,2,40,8"/>
        <CheckBox IsEnabled="{Binding StableFeatures}" x:Name="StartupCheck" Content="{loc:Tr 登录后启动到托盘}" Style="{StaticResource Switch}" IsChecked="{Binding Settings.Startup}"/><TextBlock Text="{loc:Tr 仅对当前账户生效，监测无需管理员权限。}" Style="{StaticResource Caption}" Margin="0,2,40,0"/>
      </StackPanel>
      <StackPanel x:Name="AutomationSection" Visibility="{Binding Settings.Automation, Converter={StaticResource Visible}}">
        <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions><TextBlock Text="{loc:Tr 触发依据}" VerticalAlignment="Center"/><ComboBox x:Name="TriggerModeCombo" Grid.Column="1" SelectedIndex="{Binding Settings.Draft.Mode}" AutomationProperties.Name="{loc:Tr 自动整理触发依据}"><ComboBoxItem Content="{loc:Tr 占用百分比}"/><ComboBoxItem Content="{loc:Tr Windows 低内存通知}"/></ComboBox></Grid>
        <CheckBox x:Name="ThresholdCheck" Content="{loc:Tr 持续压力触发}" Style="{StaticResource Switch}" IsChecked="{Binding Settings.Draft.ThresholdEnabled}"/>
        <StackPanel x:Name="SustainGroup" Visibility="{Binding Settings.Draft.ThresholdEnabled, Converter={StaticResource Visible}}" Margin="0,8,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="124"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="{loc:Tr 持续满足条件}"/><TextBlock Text="{loc:Tr 15～600 秒}" Style="{StaticResource Caption}" Margin="0,3,0,0"/></StackPanel><TextBox x:Name="SustainInput" Grid.Column="1" Text="{Binding Settings.Draft.Sustain, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Settings.Draft.ThresholdEnabled}" AutomationProperties.Name="{loc:Tr 持续满足条件，15～600 秒}" VerticalAlignment="Center"/></Grid></StackPanel>
        <CheckBox x:Name="TimerCheck" Content="{loc:Tr 定时检查}" Style="{StaticResource Switch}" IsChecked="{Binding Settings.Draft.TimerEnabled}"/>
        <StackPanel x:Name="IntervalGroup" Visibility="{Binding Settings.Draft.TimerEnabled, Converter={StaticResource Visible}}" Margin="0,8,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="124"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="{loc:Tr 定时检查间隔}"/><TextBlock Text="{loc:Tr 15～1440 分钟}" Style="{StaticResource Caption}" Margin="0,3,0,0"/></StackPanel><TextBox x:Name="IntervalInput" Grid.Column="1" Text="{Binding Settings.Draft.Interval, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Settings.Draft.TimerEnabled}" AutomationProperties.Name="{loc:Tr 定时检查间隔，15～1440 分钟}" VerticalAlignment="Center"/></Grid><TextBlock Text="{loc:Tr 仅在系统确有低内存时整理闲置后台。}" Style="{StaticResource Caption}" Margin="0,6,0,0"/></StackPanel>
        <StackPanel x:Name="SharedConditions" Visibility="{Binding Settings.Draft.AnyEnabled, Converter={StaticResource Visible}}">
          <Border Style="{StaticResource Rule}" Margin="0,12,0,16"/><TextBlock Text="{loc:Tr 共享压力条件}" Style="{StaticResource GroupTitle}"/>
          <StackPanel x:Name="ThresholdGroup" Visibility="{Binding Settings.Draft.PercentageEnabled, Converter={StaticResource Visible}}" Margin="0,8,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="124"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="{loc:Tr 占用门槛}"/><TextBlock Text="55～98%" Style="{StaticResource Caption}" Margin="0,3,0,0"/></StackPanel><TextBox x:Name="ThresholdInput" Grid.Column="1" Text="{Binding Settings.Draft.Threshold, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Settings.Draft.PercentageEnabled}" AutomationProperties.Name="{loc:Tr 占用门槛，55～98%}" VerticalAlignment="Center"/></Grid></StackPanel>
          <TextBlock Text="{loc:Tr 以 Windows 报告低内存为准，不套用百分比门槛。}" Style="{StaticResource Caption}" Margin="0,10,0,0" Visibility="{Binding Settings.Draft.SystemPressureEnabled, Converter={StaticResource Visible}}"/>
          <Expander Header="{loc:Tr 更多条件}" Foreground="{DynamicResource Text}" Margin="0,14,0,0"><StackPanel Margin="0,10,0,0"><Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="124"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="{loc:Tr 清理冷却}"/><TextBlock Text="{loc:Tr 5～240 分钟}" Style="{StaticResource Caption}"/></StackPanel><TextBox x:Name="CooldownInput" Grid.Column="1" Text="{Binding Settings.Draft.Cooldown, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:Tr 清理冷却，5至240分钟}"/></Grid><CheckBox Content="{loc:Tr 全屏应用使用时暂缓}" IsChecked="{Binding Settings.Draft.PauseFullscreen}"/><CheckBox Content="{loc:Tr 磁盘繁忙时暂缓}" IsChecked="{Binding Settings.Draft.PauseDisk}"/></StackPanel></Expander>
        </StackPanel>
        <Border Style="{StaticResource Rule}"/><TextBlock Text="{Binding Settings.Draft.Summary}" Style="{StaticResource Caption}"/><TextBlock Text="{loc:Tr 不会裁剪前台、刷新修改页或清空待机缓存。}" Style="{StaticResource Caption}" Margin="0,8,0,16"/>
        <WrapPanel><Button x:Name="SaveAutomationButton" Content="{Binding Settings.Draft.SaveLabel}" Style="{StaticResource PrimaryButton}" Command="{Binding Command}" CommandParameter="save-automation" Margin="0,0,8,8"/><TextBlock Text="{loc:Tr 未保存}" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Visibility="{Binding Settings.Draft.Dirty, Converter={StaticResource Visible}}" Margin="0,0,0,8"/></WrapPanel>
        <TextBlock x:Name="AutomationFeedback" Text="{Binding Settings.Draft.Feedback}" Visibility="{Binding Settings.Draft.HasFeedback, Converter={StaticResource Visible}}" Style="{StaticResource Caption}" AutomationProperties.LiveSetting="Polite"/>
      </StackPanel>
      <StackPanel x:Name="UpdatesSection" Visibility="{Binding Settings.Updates, Converter={StaticResource Visible}}">
        <TextBlock Text="{Binding Version}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/><CheckBox IsEnabled="{Binding StableFeatures}" x:Name="UpdateCheck" Content="{loc:Tr 自动检查正式版本}" Style="{StaticResource Switch}" IsChecked="{Binding Settings.CheckUpdates}"/>
        <TextBlock Text="{loc:Tr 只检查并提示。下载和重启更新均由你点击。}" Style="{StaticResource Caption}" Margin="0,8,0,16"/><TextBlock x:Name="UpdateFeedback" Text="{Binding UpdateText}" Style="{StaticResource Caption}" Margin="0,0,0,16"/>
        <WrapPanel><Button x:Name="CheckUpdateButton" Content="{loc:Tr 检查更新}" IsEnabled="{Binding NotUpdateBusy}" Command="{Binding Command}" CommandParameter="check-update" Margin="0,0,8,8"/><Button x:Name="DownloadUpdateButton" Content="{loc:Tr 下载更新}" IsEnabled="{Binding NotUpdateBusy}" Visibility="{Binding UpdateDownloadVisible, Converter={StaticResource Visible}}" Command="{Binding Command}" CommandParameter="download-update" Margin="0,0,8,8"/><Button x:Name="ApplyUpdateButton" Content="{loc:Tr 重启并更新}" Visibility="{Binding UpdateApplyVisible, Converter={StaticResource Visible}}" IsEnabled="{Binding UpdateActionEnabled}" Command="{Binding Command}" CommandParameter="apply-update" Margin="0,0,8,8"/><Button Content="{loc:Tr 取消}" Style="{StaticResource TextButton}" Visibility="{Binding UpdateBusy, Converter={StaticResource Visible}}" Command="{Binding Command}" CommandParameter="cancel-update"/></WrapPanel>
        <Button Content="{loc:Tr 下载安装包}" Style="{StaticResource PrimaryButton}" Visibility="{Binding RequiresInstaller, Converter={StaticResource Visible}}" Command="{Binding Command}" CommandParameter="releases" HorizontalAlignment="Left" Margin="0,0,0,12"/><Border Style="{StaticResource Rule}"/><Button Content="{loc:Tr 查看发行说明}" Style="{StaticResource TextButton}" Command="{Binding Command}" CommandParameter="releases" HorizontalAlignment="Left"/><TextBlock Text="{loc:Tr 更新启动异常时可从发行历史恢复安装，配置快照保留于本地数据目录。}" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
      </StackPanel>
      <StackPanel x:Name="AboutSection" Visibility="{Binding Settings.About, Converter={StaticResource Visible}}">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16"><Image Source="pack://application:,,,/ClickClean;component/Assets/ClickClean.png" Width="36" Height="36" Margin="0,0,12,0"/><StackPanel><TextBlock Text="{loc:Tr Click-Clean 即清}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{loc:Tr 原作者：离子怪}" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel></StackPanel>
        <TextBlock Text="{Binding AboutVersion}" Style="{StaticResource Caption}"/><Border Style="{StaticResource Rule}"/><TextBlock Text="GPL-3.0-only" Style="{StaticResource GroupTitle}"/><TextBlock Text="{loc:Tr Copyright © 2026 离子怪（ice11123）及贡献者。按许可证允许复制、修改与分发；本软件不提供担保。}" Style="{StaticResource Caption}" Margin="0,8,0,12"/><Button Content="{loc:Tr 查看许可证}" Command="{Binding Command}" CommandParameter="license" HorizontalAlignment="Left"/>
        <Border Style="{StaticResource Rule}"/><TextBlock Text="{loc:Tr 本地数据}" Style="{StaticResource GroupTitle}"/><TextBlock Text="{loc:Tr 删除即清的设置、历史及日志并退出。此操作不会删除旧清栖的数据。}" Style="{StaticResource Caption}" Margin="0,8,0,12"/><Button Content="{loc:Tr 清除本地数据…}" Command="{Binding Command}" CommandParameter="delete-data" HorizontalAlignment="Left"/><Button Content="{loc:Tr 完全退出即清}" Style="{StaticResource TextButton}" Command="{Binding Command}" CommandParameter="exit" HorizontalAlignment="Left" Margin="0,16,0,0"/>
      </StackPanel>
      <TextBlock Text="{Binding Settings.Feedback}" Visibility="{Binding Settings.HasFeedback, Converter={StaticResource Visible}}" Style="{StaticResource Caption}" Margin="0,14,0,0" AutomationProperties.LiveSetting="Polite"/>
    </StackPanel></ScrollViewer>
  </Grid>
</UserControl>
