<UserControl x:Class="ClickClean.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,16"><Button x:Name="SettingsBack" Content="← 返回" HorizontalAlignment="Left" Style="{StaticResource TextButton}" Visibility="{Binding Settings.IsChild, Converter={StaticResource Visible}}" Command="{Binding Command}" CommandParameter="settings-back" Margin="-6,0,0,8"/><TextBlock x:Name="SettingsHeading" Text="{Binding Settings.Heading}" Style="{StaticResource PageTitle}"/></StackPanel>
    <ScrollViewer x:Name="SettingsScroll" Grid.Row="1"><StackPanel Margin="0,0,6,4">
      <StackPanel x:Name="SettingsIndex" Visibility="{Binding Settings.Index, Converter={StaticResource Visible}}">
        <Button x:Name="AppearanceIndex" Style="{StaticResource AcrylicOption}" Margin="0,0,0,8" Command="{Binding Command}" CommandParameter="settings-appearance"><StackPanel><TextBlock Text="常规与外观   ›" FontWeight="SemiBold"/><TextBlock Text="{Binding Settings.AppearanceSummary}" Style="{StaticResource Caption}" Margin="0,6,0,0"/></StackPanel></Button>
        <Button Style="{StaticResource AcrylicOption}" Margin="0,0,0,8" Command="{Binding Command}" CommandParameter="settings-automation"><StackPanel><TextBlock Text="自动整理   ›" FontWeight="SemiBold"/><TextBlock Text="{Binding Automatic}" Style="{StaticResource Caption}" Margin="0,6,0,0"/></StackPanel></Button>
        <Button Style="{StaticResource AcrylicOption}" Margin="0,0,0,8" Command="{Binding Command}" CommandParameter="settings-updates"><StackPanel><TextBlock Text="版本更新   ›" FontWeight="SemiBold"/><TextBlock Text="手动下载与安装" Style="{StaticResource Caption}" Margin="0,6,0,0"/></StackPanel></Button>
        <Button Style="{StaticResource AcrylicOption}" Margin="0,0,0,8" Command="{Binding Command}" CommandParameter="settings-about"><StackPanel><TextBlock Text="关于   ›" FontWeight="SemiBold"/><TextBlock Text="作者与开源许可" Style="{StaticResource Caption}" Margin="0,6,0,0"/></StackPanel></Button>
      </StackPanel>
      <StackPanel x:Name="AppearanceSection" Visibility="{Binding Settings.Appearance, Converter={StaticResource Visible}}">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="172"/></Grid.ColumnDefinitions><TextBlock Text="界面主题" VerticalAlignment="Center"/><ComboBox x:Name="ThemeCombo" Grid.Column="1" SelectedIndex="{Binding Settings.Theme}" AutomationProperties.Name="界面主题"><ComboBoxItem AutomationProperties.Name="浅色"><StackPanel Orientation="Horizontal"><Border Background="#FFFFFF" BorderBrush="#A42A3A" BorderThickness="3,1,1,1" Width="16" Height="16" CornerRadius="3" Margin="0,0,8,0"/><TextBlock Text="浅色"/></StackPanel></ComboBoxItem><ComboBoxItem AutomationProperties.Name="深色"><StackPanel Orientation="Horizontal"><Border Background="#000000" BorderBrush="#7F2333" BorderThickness="3,1,1,1" Width="16" Height="16" CornerRadius="3" Margin="0,0,8,0"/><TextBlock Text="深色"/></StackPanel></ComboBoxItem><ComboBoxItem AutomationProperties.Name="跟随系统"><StackPanel Orientation="Horizontal"><Border BorderBrush="{DynamicResource Muted}" BorderThickness="1" Width="16" Height="16" CornerRadius="3" Margin="0,0,8,0"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#FFFFFF" Offset="0.49"/><GradientStop Color="#000000" Offset="0.5"/></LinearGradientBrush></Border.Background></Border><TextBlock Text="跟随系统"/></StackPanel></ComboBoxItem></ComboBox></Grid>
        <CheckBox x:Name="MotionCheck" Content="减少动画" Style="{StaticResource Switch}" IsChecked="{Binding Settings.ReduceMotion}" Margin="0,12,0,0"/>
        <CheckBox x:Name="IslandCheck" Content="桌面整理岛" Style="{StaticResource Switch}" IsChecked="{Binding Settings.Island}"/><TextBlock Text="靠近任务栏浮出，点击整理。" Style="{StaticResource Caption}" Margin="0,2,40,0"/>
        <Border Style="{StaticResource Rule}"/><TextBlock Text="运行方式" Style="{StaticResource GroupTitle}" Margin="0,0,0,8"/>
        <CheckBox x:Name="CloseToTrayCheck" Content="关闭主窗口时收起到托盘" Style="{StaticResource Switch}" IsChecked="{Binding Settings.CloseToTray}"/><TextBlock Text="完全退出请使用托盘菜单。" Style="{StaticResource Caption}" Margin="0,2,40,8"/>
        <CheckBox IsEnabled="{Binding StableFeatures}" x:Name="StartupCheck" Content="登录后启动到托盘" Style="{StaticResource Switch}" IsChecked="{Binding Settings.Startup}"/><TextBlock Text="仅对当前账户生效，以管理员权限运行。" Style="{StaticResource Caption}" Margin="0,2,40,0"/>
      </StackPanel>
      <StackPanel x:Name="AutomationSection" Visibility="{Binding Settings.Automation, Converter={StaticResource Visible}}">
        <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions><TextBlock Text="触发依据" VerticalAlignment="Center"/><ComboBox x:Name="TriggerModeCombo" Grid.Column="1" SelectedIndex="{Binding Settings.Draft.Mode}" AutomationProperties.Name="自动整理触发依据"><ComboBoxItem Content="占用百分比"/><ComboBoxItem Content="Windows 低内存通知"/></ComboBox></Grid>
        <CheckBox x:Name="ThresholdCheck" Content="持续压力触发" Style="{StaticResource Switch}" IsChecked="{Binding Settings.Draft.ThresholdEnabled}"/>
        <StackPanel x:Name="SustainGroup" Visibility="{Binding Settings.Draft.ThresholdEnabled, Converter={StaticResource Visible}}" Margin="0,8,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="124"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="持续满足条件"/><TextBlock Text="15～600 秒" Style="{StaticResource Caption}" Margin="0,3,0,0"/></StackPanel><TextBox x:Name="SustainInput" Grid.Column="1" Text="{Binding Settings.Draft.Sustain, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Settings.Draft.ThresholdEnabled}" AutomationProperties.Name="持续满足条件，15～600 秒" VerticalAlignment="Center"/></Grid></StackPanel>
        <CheckBox x:Name="TimerCheck" Content="定时检查" Style="{StaticResource Switch}" IsChecked="{Binding Settings.Draft.TimerEnabled}"/>
        <StackPanel x:Name="IntervalGroup" Visibility="{Binding Settings.Draft.TimerEnabled, Converter={StaticResource Visible}}" Margin="0,8,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="124"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="定时检查间隔"/><TextBlock Text="15～1440 分钟" Style="{StaticResource Caption}" Margin="0,3,0,0"/></StackPanel><TextBox x:Name="IntervalInput" Grid.Column="1" Text="{Binding Settings.Draft.Interval, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Settings.Draft.TimerEnabled}" AutomationProperties.Name="定时检查间隔，15～1440 分钟" VerticalAlignment="Center"/></Grid><TextBlock Text="到期后仍须满足共享压力条件。" Style="{StaticResource Caption}" Margin="0,6,0,0"/></StackPanel>
        <StackPanel x:Name="SharedConditions" Visibility="{Binding Settings.Draft.AnyEnabled, Converter={StaticResource Visible}}">
          <Border Style="{StaticResource Rule}" Margin="0,12,0,16"/><TextBlock Text="共享压力条件" Style="{StaticResource GroupTitle}"/>
          <StackPanel x:Name="ThresholdGroup" Visibility="{Binding Settings.Draft.PercentageEnabled, Converter={StaticResource Visible}}" Margin="0,8,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="124"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="占用门槛"/><TextBlock Text="55～98%" Style="{StaticResource Caption}" Margin="0,3,0,0"/></StackPanel><TextBox x:Name="ThresholdInput" Grid.Column="1" Text="{Binding Settings.Draft.Threshold, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Settings.Draft.PercentageEnabled}" AutomationProperties.Name="占用门槛，55～98%" VerticalAlignment="Center"/></Grid></StackPanel>
          <TextBlock Text="以 Windows 报告低内存为准，不套用百分比门槛。" Style="{StaticResource Caption}" Margin="0,10,0,0" Visibility="{Binding Settings.Draft.SystemPressureEnabled, Converter={StaticResource Visible}}"/>
          <Expander Header="更多条件" Foreground="{DynamicResource Text}" Margin="0,14,0,0"><StackPanel Margin="0,10,0,0"><Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="124"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="清理冷却"/><TextBlock Text="5～240 分钟" Style="{StaticResource Caption}"/></StackPanel><TextBox x:Name="CooldownInput" Grid.Column="1" Text="{Binding Settings.Draft.Cooldown, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="清理冷却，5至240分钟"/></Grid><CheckBox Content="全屏应用使用时暂缓" IsChecked="{Binding Settings.Draft.PauseFullscreen}"/><CheckBox Content="磁盘繁忙时暂缓" IsChecked="{Binding Settings.Draft.PauseDisk}"/></StackPanel></Expander>
        </StackPanel>
        <Border Style="{StaticResource Rule}"/><TextBlock Text="{Binding Settings.Draft.Summary}" Style="{StaticResource Caption}"/><TextBlock Text="全系统操作可能短暂卡顿或产生磁盘活动，不保证提速。" Style="{StaticResource Caption}" Margin="0,8,0,16"/>
        <WrapPanel><Button x:Name="SaveAutomationButton" Content="{Binding Settings.Draft.SaveLabel}" Style="{StaticResource PrimaryButton}" Command="{Binding Command}" CommandParameter="save-automation" Margin="0,0,8,8"/><TextBlock Text="未保存" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Visibility="{Binding Settings.Draft.Dirty, Converter={StaticResource Visible}}" Margin="0,0,0,8"/></WrapPanel>
        <TextBlock x:Name="AutomationFeedback" Text="{Binding Settings.Draft.Feedback}" Visibility="{Binding Settings.Draft.HasFeedback, Converter={StaticResource Visible}}" Style="{StaticResource Caption}" AutomationProperties.LiveSetting="Polite"/>
      </StackPanel>
      <StackPanel x:Name="UpdatesSection" Visibility="{Binding Settings.Updates, Converter={StaticResource Visible}}">
        <TextBlock Text="{Binding Version}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/><CheckBox IsEnabled="{Binding StableFeatures}" x:Name="UpdateCheck" Content="自动检查正式版本" Style="{StaticResource Switch}" IsChecked="{Binding Settings.CheckUpdates}"/>
        <TextBlock Text="只检查并提示。下载和重启更新均由你点击。" Style="{StaticResource Caption}" Margin="0,8,0,16"/><TextBlock x:Name="UpdateFeedback" Text="{Binding UpdateText}" Style="{StaticResource Caption}" Margin="0,0,0,16"/>
        <WrapPanel><Button x:Name="CheckUpdateButton" Content="检查更新" IsEnabled="{Binding NotUpdateBusy}" Command="{Binding Command}" CommandParameter="check-update" Margin="0,0,8,8"/><Button x:Name="DownloadUpdateButton" Content="下载更新" IsEnabled="{Binding NotUpdateBusy}" Visibility="{Binding UpdateAvailable, Converter={StaticResource Visible}}" Command="{Binding Command}" CommandParameter="download-update" Margin="0,0,8,8"/><Button x:Name="ApplyUpdateButton" Content="重启并更新" Visibility="{Binding UpdateReady, Converter={StaticResource Visible}}" IsEnabled="{Binding UpdateActionEnabled}" Command="{Binding Command}" CommandParameter="apply-update" Margin="0,0,8,8"/><Button Content="取消" Style="{StaticResource TextButton}" Visibility="{Binding UpdateBusy, Converter={StaticResource Visible}}" Command="{Binding Command}" CommandParameter="cancel-update"/></WrapPanel>
        <Border Style="{StaticResource Rule}"/><Button Content="查看发行说明" Style="{StaticResource TextButton}" Command="{Binding Command}" CommandParameter="releases" HorizontalAlignment="Left"/><TextBlock Text="更新启动异常时可从发行历史恢复安装，配置快照保留于本地数据目录。" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
      </StackPanel>
      <StackPanel x:Name="AboutSection" Visibility="{Binding Settings.About, Converter={StaticResource Visible}}">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16"><Image Source="pack://application:,,,/ClickClean;component/Assets/ClickClean.png" Width="36" Height="36" Margin="0,0,12,0"/><StackPanel><TextBlock Text="Click-Clean 即清" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="原作者：离子怪" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel></StackPanel>
        <TextBlock Text="{Binding AboutVersion}" Style="{StaticResource Caption}"/><Border Style="{StaticResource Rule}"/><TextBlock Text="GPL-3.0-only" Style="{StaticResource GroupTitle}"/><TextBlock Text="Copyright © 2026 离子怪（ice11123）及贡献者。按许可证允许复制、修改与分发；本软件不提供担保。" Style="{StaticResource Caption}" Margin="0,8,0,12"/><Button Content="查看许可证" Command="{Binding Command}" CommandParameter="license" HorizontalAlignment="Left"/>
        <Border Style="{StaticResource Rule}"/><TextBlock Text="本地数据" Style="{StaticResource GroupTitle}"/><TextBlock Text="删除即清的设置、历史及日志并退出。此操作不会删除旧清栖的数据。" Style="{StaticResource Caption}" Margin="0,8,0,12"/><Button Content="清除本地数据…" Command="{Binding Command}" CommandParameter="delete-data" HorizontalAlignment="Left"/><Button Content="完全退出即清" Style="{StaticResource TextButton}" Command="{Binding Command}" CommandParameter="exit" HorizontalAlignment="Left" Margin="0,16,0,0"/>
      </StackPanel>
      <TextBlock Text="{Binding Settings.Feedback}" Visibility="{Binding Settings.HasFeedback, Converter={StaticResource Visible}}" Style="{StaticResource Caption}" Margin="0,14,0,0" AutomationProperties.LiveSetting="Polite"/>
    </StackPanel></ScrollViewer>
  </Grid>
</UserControl>
