<UserControl x:Class="ClickClean.Views.OverviewView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer x:Name="MainContent">
    <StackPanel Margin="0,0,6,4">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="物理内存" Style="{StaticResource GroupTitle}" VerticalAlignment="Center"/><Button x:Name="MemoryDetailsButton" Grid.Column="1" Content="内存详情 ›" Style="{StaticResource TextButton}" Command="{Binding Command}" CommandParameter="memory-details"/></Grid>
      <Grid Margin="0,10,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal"><TextBlock x:Name="LoadText" Text="{Binding Load}" FontSize="36" FontWeight="SemiBold" Width="68" Typography.NumeralAlignment="Tabular" TextWrapping="NoWrap"/><TextBlock Text="%" Foreground="{DynamicResource Muted}" VerticalAlignment="Bottom" Margin="0,0,0,7"/></StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="可用内存" Style="{StaticResource Caption}"/><TextBlock x:Name="AvailableText" Text="{Binding Available}" FontSize="18" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" TextWrapping="NoWrap" Margin="0,4,0,0"/></StackPanel>
      </Grid>
      <ProgressBar x:Name="MemoryBar" Value="{Binding Percentage}" Maximum="100" Height="4" Foreground="{DynamicResource Text}" Background="{DynamicResource Line}" AutomationProperties.Name="物理内存使用率"/>
      <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0"><Run Text="已用 "/><Run Text="{Binding Used}"/><Run Text=" / 共 "/><Run Text="{Binding Total}"/></TextBlock>
      <TextBlock x:Name="MemoryError" Text="{Binding MemoryError}" Visibility="{Binding MemoryFailed, Converter={StaticResource Visible}}" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
      <Border Style="{StaticResource Rule}" Margin="0,8"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center"><TextBlock Text="原版三步整理" Style="{StaticResource GroupTitle}"/><TextBlock Text="作用于全系统" Style="{StaticResource Caption}" Margin="0,6,0,0"/></StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Center"><Button x:Name="CleanButton" Content="{Binding CleanLabel}" MinWidth="120" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding CanClean}" Command="{Binding Command}" CommandParameter="clean" AutomationProperties.Name="一键整理：裁剪工作集、刷新修改页、清理待机缓存"/></StackPanel>
      </Grid>
      <Grid MinHeight="34" Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="{Binding Operation}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0" AutomationProperties.LiveSetting="Polite"/><Button x:Name="CustomButton" Grid.Column="1" Content="自定义步骤 ›" Style="{StaticResource TextButton}" Visibility="{Binding CanClean, Converter={StaticResource Visible}}" Command="{Binding Command}" CommandParameter="custom"/><Button x:Name="CancelButton" Grid.Column="1" Content="{Binding CancelText}" Visibility="{Binding Busy, Converter={StaticResource Visible}}" IsEnabled="{Binding CanCancel}" Style="{StaticResource TextButton}" Command="{Binding Command}" CommandParameter="cancel-clean"/></Grid>
      <Border Style="{StaticResource Rule}" Margin="0,8"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="最近一次" Style="{StaticResource GroupTitle}" VerticalAlignment="Center"/><Button x:Name="RecentDetailsButton" Grid.Column="1" Content="查看详情 ›" Style="{StaticResource TextButton}" Visibility="{Binding HasRecent, Converter={StaticResource Visible}}" Command="{Binding Command}" CommandParameter="recent-details"/></Grid>
      <TextBlock Text="尚无整理记录" Style="{StaticResource Caption}" Margin="0,12,0,14" Visibility="{Binding NoRecent, Converter={StaticResource Visible}}"/>
      <StackPanel x:Name="ResultCard" Visibility="{Binding HasRecent, Converter={StaticResource Visible}}" Margin="0,8,0,0">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Recent.Outcome}" VerticalAlignment="Center"/><TextBlock x:Name="ResultDelta" Grid.Column="1" Text="{Binding Recent.Delta}" FontSize="18" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" TextWrapping="NoWrap"/></Grid>
        <TextBlock Text="{Binding Recent.Meta}" Style="{StaticResource Caption}" Margin="0,6,0,0"/><TextBlock x:Name="ResultObservationText" Text="{Binding Recent.Observation}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
      </StackPanel>
      <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="AutoStatusText" Text="{Binding Automatic}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,12,0"/><Button Grid.Column="1" Content="管理 ›" Style="{StaticResource TextButton}" Command="{Binding Command}" CommandParameter="automation-shortcut"/></Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
