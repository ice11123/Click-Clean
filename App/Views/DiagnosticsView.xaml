<UserControl x:Class="ClickClean.Views.DiagnosticsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,18"><TextBlock Text="内存增长" Style="{StaticResource PageTitle}"/><TextBlock Text="本次观察 · 每 5 秒采样 · 私有内存增长不等于泄漏" Style="{StaticResource Caption}"/></StackPanel>
    <ScrollViewer Grid.Row="1"><StackPanel Margin="0,0,6,0"><Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="106"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><TextBlock Text="进程" Style="{StaticResource Caption}"/><TextBlock Grid.Column="1" Text="私有内存" Style="{StaticResource Caption}" HorizontalAlignment="Right"/><TextBlock Grid.Column="2" Text="本次增长" Style="{StaticResource Caption}" HorizontalAlignment="Right"/></Grid>
      <ItemsControl x:Name="GrowthItems" ItemsSource="{Binding Processes}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"><Button Style="{StaticResource ListButton}" Command="{Binding DataContext.Command, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="{Binding Description}" AutomationProperties.Name="{Binding Description}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="106"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,0,12,0"/><TextBlock Grid.Column="1" Text="{Binding Size}" HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular"/><TextBlock Grid.Column="2" Text="{Binding Growth}" HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular"/></Grid></Button></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel></ScrollViewer>
    <StackPanel Grid.Row="2" Margin="0,16,0,0"><TextBlock x:Name="GrowthFeedback" Text="{Binding ProcessFeedback}" Style="{StaticResource Caption}"/><TextBlock Text="离开此页停止采样。点击进程行可查看 PID。" Style="{StaticResource Caption}" Margin="0,4,0,10"/><WrapPanel><Button Content="刷新读数" Command="{Binding Command}" CommandParameter="refresh-processes" Margin="0,0,8,6"/><Button Content="导出诊断日志" Style="{StaticResource TextButton}" Command="{Binding Command}" CommandParameter="export" Margin="0,0,0,6"/></WrapPanel></StackPanel>
  </Grid>
</UserControl>
